<?xml version="1.0" encoding="UTF-8"?>
<templateSet group="Ink">
  <template name="inkmain" value="func main(): i32&#10;{&#10;  $END$&#10;  return 0;&#10;}" description="Ink: main 入口函数" shortcut="TAB" toReformat="false" toShortenFQNames="false">
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>
  <template name="inkfunc" value="func $NAME$($PARAMS$): $RETURN_TYPE$&#10;{&#10;  $END$&#10;}" description="Ink: 函数定义" shortcut="TAB" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;doWork&quot;" alwaysStopAt="true" />
    <variable name="PARAMS" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true" />
    <variable name="RETURN_TYPE" expression="" defaultValue="&quot;void&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>
  <template name="inkif" value="if ($CONDITION$)&#10;{&#10;  $END$&#10;}" description="Ink: if 条件分支" shortcut="TAB" toReformat="false" toShortenFQNames="false">
    <variable name="CONDITION" expression="" defaultValue="&quot;true&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>
  <template name="inkife" value="if ($CONDITION$)&#10;{&#10;  $END$&#10;}&#10;else&#10;{&#10;  &#10;}" description="Ink: if / else 条件分支" shortcut="TAB" toReformat="false" toShortenFQNames="false">
    <variable name="CONDITION" expression="" defaultValue="&quot;true&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>
  <template name="inkwhile" value="while ($CONDITION$)&#10;{&#10;  $END$&#10;}" description="Ink: while 循环" shortcut="TAB" toReformat="false" toShortenFQNames="false">
    <variable name="CONDITION" expression="" defaultValue="&quot;false&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>
  <template name="inkfor" value="for (var $INDEX$: i32 = 0; $INDEX$ &lt; $LIMIT$; $INDEX$++)&#10;{&#10;  $END$&#10;}" description="Ink: 经典 for 循环" shortcut="TAB" toReformat="false" toShortenFQNames="false">
    <variable name="INDEX" expression="" defaultValue="&quot;I&quot;" alwaysStopAt="true" />
    <variable name="LIMIT" expression="" defaultValue="&quot;10&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>
  <template name="inkforin" value="for ($ITEM$ in $ITEMS$)&#10;{&#10;  $END$&#10;}" description="Ink: for / in 循环（文法模板）" shortcut="TAB" toReformat="false" toShortenFQNames="false">
    <variable name="ITEM" expression="" defaultValue="&quot;Item&quot;" alwaysStopAt="true" />
    <variable name="ITEMS" expression="" defaultValue="&quot;Items&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>
  <template name="inkct" value="comptime&#10;{&#10;  $END$&#10;}" description="Ink: 编译期代码块" shortcut="TAB" toReformat="false" toShortenFQNames="false">
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>
</templateSet>
