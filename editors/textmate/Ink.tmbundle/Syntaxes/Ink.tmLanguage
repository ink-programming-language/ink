      <key>escapes</key>
      <dict>
        <key>patterns</key>
        <array>
          <dict>
            <key>name</key>
            <string>constant.character.escape.inklang</string>
            <key>match</key>
            <string>\\(?:\r\n|\r|\n)</string>
          </dict>
          <dict>
            <key>name</key>
            <string>constant.character.escape.inklang</string>
            <key>match</key>
            <string>\\(?:[\\'"abfnrtv]|[0-7]{1,3}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|N\{[^}'"\r\n]+\})</string>
          </dict>
          <dict>
            <key>name</key>
            <string>invalid.illegal.escape.inklang</string>
            <key>match</key>
            <string>\\.</string>
          </dict>
        </array>
      </dict>
      <key>declarations</key>
      <dict>
        <key>patterns</key>
        <array>
          <dict>
            <key>match</key>
            <string>(?&lt;![\p{L}\p{N}\p{M}\p{Pc}])(func)[ \t]+([\p{L}\p{Nl}_][\p{L}\p{N}\p{M}\p{Pc}]*)(?![\p{L}\p{N}\p{M}\p{Pc}])</string>
            <key>captures</key>
            <dict>
              <key>1</key>
              <dict>
                <key>name</key>
                <string>storage.type.function.inklang</string>
              </dict>
              <key>2</key>
              <dict>
                <key>name</key>
                <string>entity.name.function.inklang</string>
              </dict>
            </dict>
          </dict>
          <dict>
            <key>match</key>
            <string>(?&lt;![\p{L}\p{N}\p{M}\p{Pc}])(class|enum|interface)[ \t]+([\p{L}\p{Nl}_][\p{L}\p{N}\p{M}\p{Pc}]*)(?![\p{L}\p{N}\p{M}\p{Pc}])</string>
            <key>captures</key>
            <dict>
              <key>1</key>
              <dict>
                <key>name</key>
                <string>storage.type.inklang</string>
              </dict>
              <key>2</key>
              <dict>
                <key>name</key>
                <string>entity.name.type.inklang</string>
              </dict>
            </dict>
          </dict>
        </array>
      </dict>
      <key>keywords</key>
      <dict>
        <key>patterns</key>
        <array>
          <dict>
            <key>name</key>
            <string>storage.type.inklang</string>
            <key>match</key>
            <string>(?&lt;![\p{L}\p{N}\p{M}\p{Pc}])(?:class|enum|field|func|interface|var)(?![\p{L}\p{N}\p{M}\p{Pc}])</string>
          </dict>
          <dict>
            <key>name</key>
            <string>storage.modifier.inklang</string>
            <key>match</key>
            <string>(?&lt;![\p{L}\p{N}\p{M}\p{Pc}])(?:comptime|const|export|implements|private|public)(?![\p{L}\p{N}\p{M}\p{Pc}])</string>
          </dict>
          <dict>
            <key>name</key>
            <string>keyword.control.inklang</string>
            <key>match</key>
            <string>(?&lt;![\p{L}\p{N}\p{M}\p{Pc}])(?:as|break|case|continue|default|defer|do|else|for|from|if|import|in|match|return|switch|while|yield)(?![\p{L}\p{N}\p{M}\p{Pc}])</string>
          </dict>
        </array>
      </dict>
      <key>builtins</key>
      <dict>
        <key>patterns</key>
        <array>
          <dict>
            <key>name</key>
            <string>support.type.builtin.inklang</string>
            <key>match</key>
            <string>(?&lt;![\p{L}\p{N}\p{M}\p{Pc}])(?:void|bool|type|[iu](?:8|16|32|64|128)|f(?:16|32|64))(?![\p{L}\p{N}\p{M}\p{Pc}])</string>
          </dict>
          <dict>
            <key>name</key>
            <string>constant.language.inklang</string>
            <key>match</key>
            <string>(?&lt;![\p{L}\p{N}\p{M}\p{Pc}])(?:true|false)(?![\p{L}\p{N}\p{M}\p{Pc}])</string>
          </dict>
        </array>
      </dict>
      <key>numbers</key>
      <dict>
        <key>patterns</key>
        <array>
          <dict>
            <key>name</key>
            <string>invalid.illegal.numeric.inklang</string>
            <key>match</key>
            <string>(?&lt;![\p{L}\p{N}\p{M}\p{Pc}])0[xX][0-9A-Fa-f]+(?:\.[0-9A-Fa-fpP][\p{L}\p{N}\p{M}\p{Pc}]*|[pP][+-]?[\p{L}\p{N}\p{M}\p{Pc}]*)(?:[+-][0-9]+)?</string>
          </dict>
          <dict>
            <key>name</key>
            <string>constant.numeric.inklang</string>
            <key>match</key>
            <string>(?&lt;![\p{L}\p{N}\p{M}\p{Pc}])(?&gt;0[xX][0-9A-Fa-f]+|0[bB][01]+|0[oO][0-7]+|[0-9]+(?:\.[0-9]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)?)(?![\p{L}\p{N}\p{M}\p{Pc}])</string>
          </dict>
          <dict>
            <key>name</key>
            <string>invalid.illegal.numeric.inklang</string>
            <key>match</key>
            <string>(?&lt;![\p{L}\p{N}\p{M}\p{Pc}])[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?)?[\p{L}\p{N}\p{M}\p{Pc}]*</string>
          </dict>
        </array>
      </dict>
      <key>operators</key>
      <dict>
        <key>patterns</key>
        <array>
          <dict>
            <key>name</key>
            <string>keyword.operator.inklang</string>
            <key>match</key>
            <string>&lt;&lt;=|&gt;&gt;=|\?\?|\?\.|::|-&gt;|=&gt;|\+\+|--|&amp;&amp;|\|\||&lt;&lt;|&gt;&gt;|&lt;=|&gt;=|==|!=|[+\-*/%&amp;|^]=|[+\-*/%&amp;|^!~&lt;&gt;=?]</string>
          </dict>
          <dict>
            <key>name</key>
            <string>punctuation.separator.inklang</string>
            <key>match</key>
            <string>\.\.\.|[.,;:]</string>
          </dict>
          <dict>
            <key>name</key>
            <string>punctuation.section.inklang</string>
            <key>match</key>
            <string>[(){}\[\]]</string>
          </dict>
        </array>
      </dict>
      <key>identifiers</key>
      <dict>
        <key>patterns</key>
        <array>
          <dict>
            <key>name</key>
            <string>entity.name.function.inklang</string>
            <key>match</key>
            <string>(?&lt;![\p{L}\p{N}\p{M}\p{Pc}])[\p{L}\p{Nl}_][\p{L}\p{N}\p{M}\p{Pc}]*(?=[ \t]*\()</string>
          </dict>
          <dict>
            <key>name</key>
            <string>variable.other.inklang</string>
            <key>match</key>
            <string>(?&lt;![\p{L}\p{N}\p{M}\p{Pc}])[\p{L}\p{Nl}_][\p{L}\p{N}\p{M}\p{Pc}]*</string>
          </dict>
        </array>
      </dict>
    </dict>
  </dict>
</plist>
