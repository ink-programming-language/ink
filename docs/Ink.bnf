// 文法约定：
// 1. 小写下划线名称表示非终结符，必须在本文件中定义产生式。
// 2. 大写下划线名称表示词法层提供的终结符，例如 IDENTIFIER、INTEGER_LITERAL。
//    本文件不展开这些终结符的字符匹配规则。
// 3. 双引号中的文本表示固定拼写的终结符，例如 "if"、"+"、"("。
// 4. EOF 表示输入结束标记，不对应源码字符。
// 5. 空白和注释由词法层处理，不进入语法分析使用的 token 序列。

module ::= { stmt } EOF ;

stmt ::= closed_stmt
       | open_stmt ;


closed_stmt ::= [ "comptime" ] closed_stmt_core ;

open_stmt ::= [ "comptime" ] open_stmt_core ;

closed_stmt_core ::= basic_stmt
                   | "if" "(" expr ")" closed_stmt "else" closed_stmt
                   | "while" "(" expr ")" closed_stmt
                   | "for" "(" for_header ")" closed_stmt ;

open_stmt_core ::= "if" "(" expr ")" stmt
                 | "if" "(" expr ")" closed_stmt "else" open_stmt
                 | "while" "(" expr ")" open_stmt
                 | "for" "(" for_header ")" open_stmt ;

basic_stmt ::= decl_stmt
             | block_stmt
             | continue_stmt
             | break_stmt
             | return_stmt
             | assignment_stmt
             | expr_stmt ;

decl_stmt ::= decl ;

decl ::= attributes decl_core ;

attributes ::= [ "[" attribute { "," attribute } "]" ] ;

attribute ::= IDENTIFIER [ attribute_suffix ] ;

attribute_suffix ::= "(" [ expr_list ] ")"
                   | "=" expr ;

decl_core ::= class_decl
            | var_decl
            | enum_decl
            | interface_decl
            | function_decl ;

class_decl ::= "class" IDENTIFIER [generic_params] [base_clause] class_body ";" ;

enum_decl ::= "enum" IDENTIFIER [generic_params] [base_clause] class_body ";" ;

interface_decl ::= "interface" IDENTIFIER [generic_params] [base_clause] class_body ";" ;

generic_params ::= "[" generic_param { "," generic_param } "]" ;

generic_param ::= IDENTIFIER ":" expr ;


base_clause ::= ":" base_spec { "," base_spec } ;

base_spec ::= expr
            | "implements" expr ;

function_decl ::= "func" callable_signature callable_body ;

callable_signature ::= IDENTIFIER generic_params_opt "(" params_opt ")" ":" expr ;

callable_body ::= block_stmt
                | ";" ;

generic_params_opt ::= [ "[" typed_param_list "]" ] ;

typed_param_list ::= typed_param typed_param_tail ;

typed_param_tail ::= [ "," typed_param typed_param_tail ] ;

typed_param ::= IDENTIFIER ":" expr ;

params_opt ::= [typed_param_list] ;

class_body ::= "{" { stmt } "}" ;

var_decl ::= declaration ";" ;

declaration ::= "var" IDENTIFIER declaration_tail
              | "const" IDENTIFIER [ ":" expr ] "=" expr
              | "field" IDENTIFIER [ declaration_tail ] ;

declaration_tail ::= ":" expr [ "=" expr ]
                   | "=" expr ;

block_stmt    ::= "{" { stmt } "}" ;
return_stmt   ::= "return" [ expr ] ";" ;
break_stmt    ::= "break" ";" ;
continue_stmt ::= "continue" ";" ;
expr_stmt     ::= expr ";" ;

for_header ::= for_classic_header
             | for_in_header ;

for_classic_header ::= [ for_init ] ";" [ expr ] ";" [ for_step ] ;

for_in_header ::= for_binding "in" expr ;

for_binding ::= IDENTIFIER ;

for_init ::= declaration
           | assignment
           | expr ;

for_step ::= assignment
           | expr ;

assignment ::= expr_list assignment_op expr_list ;

assignment_stmt ::= assignment ";" ;

assignment_op ::= "="
                | "+=" | "-=" | "*=" | "/=" | "%="
                | "<<=" | ">>="
                | "&=" | "^=" | "|=" ;

expr_list ::= expr { "," expr } ;


expr ::= conditional ;

conditional ::= logical_or [ "?" expr ":" conditional ] ;


logical_or ::= logical_and { "||" logical_and } ;

logical_and ::= bit_or { "&&" bit_or } ;


bit_or ::= bit_xor { "|" bit_xor } ;

bit_xor ::= bit_and { "^" bit_and } ;

bit_and ::= equality { "&" equality } ;


equality ::= relational { ("==" | "!=") relational } ;

relational ::= shift { ("<" | "<=" | ">" | ">=") shift } ;


shift ::= add { ("<<" | ">>") add } ;

add ::= mul { ("+" | "-") mul } ;

mul ::= unary { ("*" | "/" | "%") unary } ;


unary ::= unary_op unary
        | comptime_expr
        | postfix ;

comptime_expr ::= "comptime" unary ;

unary_op ::= "+" | "-"
           | "!" | "~"
           | "++" | "--"
           | "&" | "*" ;


postfix ::= primary { postfix_op } ;

postfix_op ::= "(" [ expr_list ] ")"
             | "[" expr "]"
             | generic_args
             | "." IDENTIFIER
             | "->" IDENTIFIER
             | "++"
             | "--" ;

generic_args ::= "::" "[" [ expr_list ] "]" ;

primary ::= IDENTIFIER
          | literal
          | "(" expr ")" ;

literal ::= INTEGER_LITERAL
          | FLOAT_LITERAL
          | CHAR_LITERAL
          | STRING_LITERAL ;