// 文法约定：
// 1. 小写下划线名称表示非终结符，必须在本文件中定义产生式。
// 2. 大写下划线名称表示词法层提供的终结符，例如 IDENTIFIER、INTEGER_LITERAL。
//    本文件不展开这些终结符的字符匹配规则。
// 3. 双引号中的文本表示固定拼写的终结符，例如 "if"、"+"、"("。
// 4. EOF 表示输入结束标记，不对应源码字符。
// 5. 空白和注释由词法层处理，不进入语法分析使用的 token 序列。

module ::= { stmt } EOF ;

stmt ::= closed_stmt
       | open_stmt ;


closed_stmt ::= basic_stmt
              | [ "comptime" ] closed_stmt_core ;

open_stmt ::= [ "comptime" ] open_stmt_core ;


closed_stmt_core ::= "if" "(" expr ")" closed_stmt "else" closed_stmt
                   | "while" "(" expr ")" closed_stmt
                   | "for" "(" for_header ")" closed_stmt
                   | switch_stmt;

open_stmt_core ::= "if" "(" expr ")" stmt
                 | "if" "(" expr ")" closed_stmt "else" open_stmt
                 | "while" "(" expr ")" open_stmt
                 | "for" "(" for_header ")" open_stmt ;


basic_stmt ::= [ "comptime" ] decl_stmt
             | [ "comptime" ] block_stmt
             | [ "comptime" ] import_stmt
             | defer_stmt
             | continue_stmt
             | break_stmt
             | return_stmt
             | yield_stmt
             | simple_stmt ;

yield_stmt ::= "yield" expr ";"
             | "yield" "return" expr ";" ;

switch_stmt ::= "switch" "(" expr ")" "{"
                    { switch_clause }
                "}" ;

switch_clause ::= switch_label { stmt } ;

switch_label ::= "case" expr ":"
               | "default" ":" ;

match_expr ::= "match" "(" expr ")" "{"
                  [ match_arm_list ]
              "}" ;

match_arm_list ::= match_arm
                   { "," match_arm } ;

match_arm ::= pattern [ match_guard ]
              "=>" expr ;

match_guard ::= "if" "(" expr ")" ;

pattern ::= pattern_atom { "|" pattern_atom } ;

pattern_atom ::= "_"
               | literal_pattern
               | name_pattern
               | grouped_pattern
               | tuple_pattern
               | array_pattern ;

array_pattern ::= "[" [ array_pattern_items ] "]" ;

array_pattern_items ::= rest_binding_pattern
                      | pattern
                        [ "," array_pattern_items ] ;

literal_pattern ::= literal
                  | "-" ( INTEGER_LITERAL | FLOAT_LITERAL ) ;

name_pattern ::= pattern_path
                 [ "(" [ pattern_list ] ")" ] ;

pattern_path ::= IDENTIFIER [ generic_args ]
                 { "." IDENTIFIER [ generic_args ] } ;

pattern_list ::= pattern { "," pattern } ;

grouped_pattern ::= "(" pattern ")" ;

tuple_pattern ::= "(" ")"
                | "(" pattern "," [ pattern_list ] ")" ;

defer_stmt ::= "defer" ( simple_stmt | block_stmt ) ;

import_stmt ::= "import" module_import_list ";"
              | "from" import_source "import" name_import_list ";" ;

import_source ::= module_path
                | relative_prefix [ module_path ] ;

relative_prefix ::= relative_dot { relative_dot } ;

relative_dot ::= "."
               | "..." ;

module_import_list ::= module_import { "," module_import } ;

module_import ::= module_path [ import_alias ] ;

name_import_list ::= name_import { "," name_import } ;

name_import ::= IDENTIFIER [ import_alias ] ;

import_alias ::= "as" IDENTIFIER ;

module_path ::= qualified_name ;

simple_stmt ::= simple_stmt_list ";" ;

simple_stmt_list ::= simple_stmt_item { "," simple_stmt_item } ;

simple_stmt_item ::= expr [ assignment_op expr ] ;

decl_stmt ::= decl ;

decl ::= attributes decl_core ;

attributes ::= [ "[" attribute { "," attribute } "]" ] ;

attribute ::= qualified_name [ attribute_suffix ] ;

attribute_suffix ::= "(" [ argument_list ] ")"
                   | "=" expr ;

decl_core ::= class_decl
            | var_decl
            | field_decl
            | enum_decl
            | interface_decl
            | function_decl ;

class_decl ::= "class" IDENTIFIER [ generic_params ] class_decl_tail ;

class_decl_tail ::= ";"
                  | [ base_clause ] class_body ";" ;

enum_decl ::= "enum" IDENTIFIER [generic_params] [base_clause] class_body ";" ;

interface_decl ::= "interface" IDENTIFIER [generic_params] [base_clause] class_body ";" ;

base_clause ::= ":" base_spec { "," base_spec } ;

base_spec ::= type_expr
            | "implements" type_expr ;

function_decl ::= "func" callable_signature callable_body ;

callable_signature ::= IDENTIFIER generic_params_opt "(" params_opt ")" ":" type_expr ;

callable_body ::= block_stmt
                | ";" ;

generic_params ::= "[" param_list "]" ;

generic_params_opt ::= [ generic_params ] ;

params_opt ::= [ param_list ] ;

param_list ::= param { "," param };

param ::= typed_param [ "=" expr | "..." ] ;

typed_param ::= IDENTIFIER ":" type_expr  ;

class_body ::= "{" { stmt } "}" ;

var_decl ::= declaration ";" ;

declaration ::= ("var" | "const") binding_pattern
                [ ":" type_expr ] "=" expr
              | "var" IDENTIFIER [ ":" type_expr ] ;

field_decl ::= "field" IDENTIFIER [ field_decl_tail ] ";" ;

field_decl_tail ::= ":" type_expr [ "=" expr ]
                  | "=" expr
                  | "(" field_payload_list ")" [ "=" expr ] ;

field_payload_list ::= field_payload
                       { "," field_payload } ;

field_payload ::= IDENTIFIER ":" type_expr ;

binding_pattern ::= IDENTIFIER
                  | "_"
                  | tuple_binding_pattern
                  | array_binding_pattern ;

array_binding_pattern ::= "[" [ array_binding_items ] "]" ;

array_binding_items ::= rest_binding_pattern
                      | binding_pattern
                        [ "," array_binding_items ] ;

rest_binding_pattern ::= ( IDENTIFIER | "_" ) "..." ;

tuple_binding_pattern ::= "(" binding_pattern "," [ binding_pattern_list ] ")" ;

binding_pattern_list ::= binding_pattern
                         { "," binding_pattern };

block_stmt    ::= "{" { stmt } "}" ;
return_stmt   ::= "return" [ expr ] ";" ;
break_stmt    ::= "break" ";" ;
continue_stmt ::= "continue" ";" ;

for_header ::= for_classic_header
             | for_in_header ;

for_classic_header ::= [ for_init ] ";" [ expr ] ";" [ for_step ] ;

for_in_header ::= for_binding "in" expr ;

for_binding ::= binding_pattern  ;

for_init ::= declaration
           | simple_stmt_list ;

for_step ::= simple_stmt_list  ;

assignment_op ::= "="
                | "+=" | "-=" | "*=" | "/=" | "%="
                | "<<=" | ">>="
                | "&=" | "^=" | "|=" ;


expr ::= conditional ;

conditional ::= null_coalescing
                [ "?" expr ":" conditional ] ;

null_coalescing ::= logical_or
                   [ "??" null_coalescing ] ;


logical_or ::= logical_and { "||" logical_and } ;

logical_and ::= bit_or { "&&" bit_or } ;


bit_or ::= bit_xor { "|" bit_xor } ;

bit_xor ::= bit_and { "^" bit_and } ;

bit_and ::= equality { "&" equality } ;


equality ::= relational { ("==" | "!=") relational } ;

relational ::= shift { ("<" | "<=" | ">" | ">=") shift } ;


shift ::= add { ("<<" | ">>") add } ;

add ::= mul { ("+" | "-") mul } ;

mul ::= unary { ("*" | "/" | "%") unary } ;


unary ::= unary_op unary
        | comptime_expr
        | function_type_expr
        | postfix ;

comptime_expr ::= "comptime" unary ;

unary_op ::= "+" | "-"
           | "!" | "~"
           | "++" | "--"
           | "&" | "*" ;


postfix ::= primary { postfix_op } ;

postfix_op ::= "(" [ argument_list ] ")"
             | "[" expr "]"
             | generic_args
             | "." IDENTIFIER
             | "->" IDENTIFIER
             | "?." IDENTIFIER
             | "?." "[" expr "]"
             | "?." "(" [ argument_list ] ")"
             | "++"
             | "--" ;

generic_args ::= "::" "[" [ argument_list ] "]" ;

argument_list ::= argument { "," argument } ;

argument ::= named_argument
           | positional_argument ;

named_argument ::= IDENTIFIER "=" expr ;

positional_argument ::= expr [ "..." ] ;

primary ::= IDENTIFIER
          | literal
          | grouped_expr
          | array_expr
          | tuple_expr
          | anonymous_function_expr
          | match_expr
          | block_expr ;

grouped_expr ::= "(" expr ")" ;

array_expr ::= "[" [ element_list ] "]"
             | "[" expr ";" expr "]" ;

tuple_expr ::= "(" ")"
             | "(" expr "," [ element_list ] ")" ;

anonymous_function_expr ::= "func" generic_params_opt
                            "(" params_opt ")" [ ":" type_expr  ] block_stmt ;

element_list ::= expr { "," expr };

function_type_expr ::= "func"
                       "(" [ function_type_param_list ] ")"
                       ":" type_expr ;

function_type_param_list ::= function_type_param
                            { "," function_type_param } ;

function_type_param ::= [ IDENTIFIER ":" ]
                        type_expr
                        [ "..." ] ;


type_expr ::= function_type_expr
            | unary_op type_expr
            | "comptime" type_expr
            | type_primary { postfix_op } ;

block_expr ::= "do" block_stmt ;

type_primary ::= IDENTIFIER
               | literal
               | grouped_expr
               | array_expr
               | tuple_expr
               | block_expr ;

qualified_name ::= IDENTIFIER { "." IDENTIFIER } ;

literal ::= INTEGER_LITERAL
          | FLOAT_LITERAL
          | CHAR_LITERAL
          | STRING_LITERAL ;