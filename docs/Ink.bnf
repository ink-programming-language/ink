module ::= { stmt } EOF ;

stmt ::= [ "comptime" ] stmt_core ;

stmt_core ::= decl_stmt
            | other_stmt ;

decl_stmt ::= decl ;

decl ::= attributes decl_core ;

decl_core ::= class_decl
            | var_decl
            | enum_decl
            | interface_decl
            | function_decl ;

class_decl ::= "class" IDENTIFIER [generic_params] [base_clause] class_body ";" ;

enum_decl ::= "enum" IDENTIFIER [generic_params] [base_clause] class_body ";" ;

interface_decl ::= "interface" IDENTIFIER [generic_params] [base_clause] class_body ";" ;

generic_params ::= "[" generic_param { "," generic_param } "]" ;

generic_param ::= identifier ":" expr ;


base_clause ::= ":" base_spec { "," base_spec } ;

base_spec ::= expr
            | "implements" expr ;

function_decl ::= "func" callable_signature callable_body ;

callable_signature ::= identifier generic_params_opt "(" params_opt ")" ":" expr ;

callable_body ::= block_stmt
                | ";" ;

generic_params_opt ::= [ "[" typed_param_list "]" ] ;

typed_param_list ::= typed_param typed_param_tail ;

typed_param_tail ::= [ "," typed_param typed_param_tail ] ;

typed_param ::= identifier ":" expr ;

params_opt ::= [typed_param_list] ;

class_body ::= "{" { stmt } "}" ;

var_decl ::= declaration ";" ;

declaration ::= decl_kind identifier ":" expr "=" expr
            | "field" identifier [ "=" expr ] ;

decl_kind ::= "var"
            | "const"
            | "field" ;

other_stmt ::= block_stmt
             | if_stmt
             | for_stmt
             | while_stmt
             | continue_stmt
             | break_stmt
             | return_stmt
             | assignment_stmt
             | expr_stmt ;

block_stmt    ::= "{" { stmt } "}" ;
if_stmt       ::= "if" "(" expr ")" stmt [ "else" stmt ] ;
while_stmt    ::= "while" "(" expr ")" stmt ;
return_stmt   ::= "return" [ expr ] ";" ;
break_stmt    ::= "break" ";" ;
continue_stmt ::= "continue" ";" ;
expr_stmt     ::= expr ";" ;

for_stmt ::= "for" "(" for_header ")" stmt ;

for_header ::= for_classic_header
             | for_in_header ;

for_classic_header ::= [ for_init ] ";" [ expr ] ";" [ for_step ] ;

for_in_header ::= for_binding "in" expr ;

for_binding ::= IDENTIFIER ;

for_init ::= declaration
           | assignment
           | expr ;

for_step ::= assignment
           | expr ;

assignment ::= expr_list assignment_op expr_list ;

assignment_stmt ::= assignment ";" ;

assignment_op ::= "="
                | "+=" | "-=" | "*=" | "/=" | "%="
                | "<<=" | ">>="
                | "&=" | "^=" | "|=" ;

expr_list ::= expr { "," expr } ;


expr ::= conditional ;

conditional ::= logical_or [ "?" expr ":" conditional ] ;


logical_or ::= logical_and { "||" logical_and } ;

logical_and ::= bit_or { "&&" bit_or } ;


bit_or ::= bit_xor { "|" bit_xor } ;

bit_xor ::= bit_and { "^" bit_and } ;

bit_and ::= equality { "&" equality } ;


equality ::= relational { ("==" | "!=") relational } ;

relational ::= shift { ("<" | "<=" | ">" | ">=") shift } ;


shift ::= add { ("<<" | ">>") add } ;

add ::= mul { ("+" | "-") mul } ;

mul ::= unary { ("*" | "/" | "%") unary } ;


unary ::= unary_op unary
        | comptime_expr
        | postfix ;

comptime_expr ::= "comptime" unary ;

unary_op ::= "+" | "-"
           | "!" | "~"
           | "++" | "--"
           | "&" | "*" ;


postfix ::= primary { postfix_op } ;

postfix_op ::= "(" [ expr_list ] ")"
             | "[" expr "]"
             | "." identifier
             | "->" identifier
             | "++"
             | "--" ;


primary ::= IDENTIFIER
          | literal
          | "(" expr ")" ;