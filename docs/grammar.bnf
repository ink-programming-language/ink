(* The lexical grammar and tokenization conventions are defined in lexer.bnf.
   This syntactic grammar operates on the tokens produced by that grammar.

   Syntactic conventions:
   - At statement start, "comptime" introduces a comptime_statement and
     applies to the complete following statement. In an expression it is
     a unary prefix; parentheses extend its operand to a larger expression.
   - Function calls and object construction share call_suffix: "callee(args)".
     Braces delimit statement blocks and declaration bodies; "T{args}" is
     not an expression or an object construction form.
   - Special sequences below are syntactic predicates. They do not consult
     name resolution, type information, or compile-time evaluation results.

   Type evaluation:
   - Every expression used as a type is implicitly comptime. It must be
     evaluable at compile time and produce a type value; otherwise report
     an error. This includes calls such as "let x: makeType() = value;".
     The initializer "value" is not made comptime by the type annotation.
   - Type operands and function-type parameter and result types obey the
     same rule. Tuple and array type spellings reuse tuple_expression and
     index_suffix; their interpretation as types is checked during evaluation.
   - An enum base type must additionally evaluate to an integer type.
   - Explicit comptime expressions and statements must be evaluable or
     executable at compile time; failure is an error, with no runtime fallback.

   Call evaluation:
   - A call suffix invokes a function when its callee is a function value.
     When its callee is a type value, it constructs an object of that type;
     constructor selection and argument checking belong to semantic analysis.
   - A construction target must evaluate to a type value at compile time.
     Computed targets use the same syntax, for example "makeType()(value)".
     This requirement does not make the construction or its arguments
     comptime unless the surrounding context requires it.
*)

source_file =
    { module_declaration }, end_of_file ;

module_declaration =
    statement ;

declaration =
      function_declaration
    | class_declaration
    | interface_declaration
    | enum_declaration ;

function_declaration =
    [ access_modifier ], [ linkage_specifier ],
    function_signature, ( function_body | ";" ) ;

function_introducer =
      [ "const" ], "func"
    | "class_method" ;

function_signature =
    function_introducer, identifier, [ generic_parameter_list ],
    parameter_list, "->", type ;

generic_parameter_list =
    "[",
    (
        generic_parameter, { ",", generic_parameter },
        [ ",", default_generic_parameter,
          { ",", default_generic_parameter } ],
        [ ",", variadic_generic_parameter ]
      | default_generic_parameter,
        { ",", default_generic_parameter },
        [ ",", variadic_generic_parameter ]
      | variadic_generic_parameter
    ),
    "]" ;

generic_parameter =
    identifier, ":", type ;

default_generic_parameter =
    generic_parameter, "=", expression ;

variadic_generic_parameter =
    generic_parameter, "..." ;

parameter_list =
    "(",
    [
        parameter, { ",", parameter },
        [ ",", default_parameter, { ",", default_parameter } ],
        [ ",", ( variadic_typed_parameter | variadic_parameter ) ]
      | default_parameter, { ",", default_parameter },
        [ ",", ( variadic_typed_parameter | variadic_parameter ) ]
      | variadic_typed_parameter
      | variadic_parameter
    ],
    ")" ;

parameter =
    binding_pattern, ":", type ;

default_parameter =
    parameter, "=", expression ;

variadic_parameter =
    "..." ;

variadic_typed_parameter =
    parameter, "..." ;

variadic_type =
    type, "..." ;

function_body =
    block_statement ;

class_declaration =
    [ access_modifier ], "class", identifier,
    [ generic_parameter_list ],
    [ class_inheritance_clause ], class_body ;

class_inheritance_clause =
      "extends", type, [ "implements", header_type_list ]
    | "implements", header_type_list ;

header_type_list =
    type, { ",", type } ;

class_body =
    block_statement ;

interface_declaration =
    [ access_modifier ], "interface", identifier,
    [ generic_parameter_list ],
    [ "extends", header_type_list ], interface_body ;

interface_body =
    block_statement ;

enum_declaration =
    [ access_modifier ], "enum", identifier,
    [ generic_parameter_list ],
    [ enum_base_clause ], enum_body ;

enum_base_clause =
      ":", type, [ "implements", header_type_list ]
    | "implements", header_type_list ;

enum_body =
    block_statement ;

enum_field_statement =
    "enum_field", identifier, [ "=", expression ], ";" ;

class_field_statement =
    [ access_modifier ], [ "const" ], "class_field",
    identifier, ":", type, [ "=", expression ], ";" ;

type =
    expression ;

(* Prefix type constructors consume one unary operand. Use parentheses for
   a binary or conditional type computation, for example "ptr (a ? T : U)".
   The result of a function type uses the same operand boundary, for example
   "func() -> (a ? T : U)".
*)
type_operand =
    unary_expression ;

builtin_type =
      "void"
    | "bool"
    | "int8"
    | "int16"
    | "int32"
    | "int64"
    | "uint8"
    | "uint16"
    | "uint32"
    | "uint64"
    | "float"
    | "double" ;

generic_argument_list =
    "::", "[",
    (
        generic_argument, { ",", generic_argument },
        [ ",", pack_expansion ]
      | pack_expansion
    ),
    "]" ;

generic_argument =
    expression ;

function_type =
    [ linkage_specifier ], "func", "(",
    [
        type, { ",", type },
        [ ",", ( variadic_type | variadic_parameter ) ]
      | variadic_type
      | variadic_parameter
    ],
    ")", "->", type_operand ;

reference_type =
    [ "const" ], "ref", type_operand ;

pointer_type =
    [ "const" ], "ptr", type_operand ;

metatype =
    "type" ;

expression =
    conditional_expression ;

comptime_expression =
    "comptime", unary_expression ;

conditional_expression =
    logical_or_expression,
    [ "?", expression, ":", expression ] ;

logical_or_expression =
    logical_and_expression,
    { "||", logical_and_expression } ;

logical_and_expression =
    bitwise_or_expression,
    { "&&", bitwise_or_expression } ;

bitwise_or_expression =
    bitwise_xor_expression,
    { "|", bitwise_xor_expression } ;

bitwise_xor_expression =
    bitwise_and_expression,
    { "^", bitwise_and_expression } ;

bitwise_and_expression =
    equality_expression,
    { "&", equality_expression } ;

equality_expression =
    relational_expression,
    [ ( "==" | "!=" ), relational_expression ] ;

relational_expression =
    shift_expression,
    [ ( "<" | "<=" | ">" | ">=" ), shift_expression ] ;

shift_expression =
    additive_expression,
    { ( "<<" | ">>" ), additive_expression } ;

additive_expression =
    multiplicative_expression,
    { ( "+" | "-" ), multiplicative_expression } ;

multiplicative_expression =
    unary_expression,
    { ( "*" | "/" | "%" ), unary_expression } ;

unary_expression =
      postfix_expression
    | unary_operator, unary_expression
    | comptime_expression ;

unary_operator =
      "+"
    | "-"
    | "!"
    | "~"
    | "&"
    | "*" ;

postfix_expression =
      primary_expression, { postfix_operation }
    | reference_type
    | pointer_type
    | function_type ;

postfix_operation =
      generic_argument_list
    | call_suffix
    | index_suffix
    | member_suffix ;

call_suffix =
    "(", [ argument_list ], ")" ;

argument =
    expression ;

pack_expansion =
    expression, "..." ;

argument_list =
      argument, { ",", argument }, [ ",", pack_expansion ]
    | pack_expansion ;

index_suffix =
    "[", expression, "]" ;

member_suffix =
      ".", identifier
    | "->", identifier ;

primary_expression =
      literal
    | keyword_value
    | receiver_expression
    | identifier
    | builtin_type
    | metatype
    | parenthesized_expression
    | tuple_expression
    | array_expression ;

parenthesized_expression =
    "(", expression, ")" ;

tuple_expression =
    "(", expression, ",", expression,
    { ",", expression }, ")" ;

array_expression =
    "[", [ expression, { ",", expression } ], "]" ;

keyword_value =
      "true"
    | "false"
    | "null" ;

receiver_expression =
      "self"
    | "super" ;

access_modifier =
      "public"
    | "private" ;

linkage_specifier =
    "extern", string_literal ;

import_statement =
      "import", package_name, [ import_alias ], ";"
    | "from", package_name, "import", identifier, [ import_alias ], ";" ;

package_name =
    identifier, { ".", identifier } ;

import_alias =
    "as", identifier ;

statement =
      comptime_statement
    | non_comptime_statement ;

non_comptime_statement =
    ? the next token is not "comptime" ?,
    (
        block_statement
      | import_statement
      | declaration
      | binding_statement
      | class_field_statement
      | enum_field_statement
      | assignment_statement
      | expression_statement
      | if_statement
      | while_statement
      | for_statement
      | break_statement
      | continue_statement
      | return_statement
      | defer_statement
    ) ;

comptime_statement =
    "comptime", statement ;

block_statement =
    "{", { statement }, "}" ;

assignment =
    assignment_target, assignment_operator, expression ;

assignment_statement =
    assignment, ";" ;

assignment_target =
    unary_expression ;

assignment_operator =
      "="
    | "+="
    | "-="
    | "*="
    | "/="
    | "%="
    | "&="
    | "|="
    | "^="
    | "<<="
    | ">>=" ;

expression_statement =
    expression, ";" ;

if_statement =
    "if", "(", expression, ")", block_statement,
    { "else", "if", "(", expression, ")", block_statement },
    [ "else", block_statement ] ;

while_statement =
    "while", "(", expression, ")", block_statement ;

for_statement =
    "for", "(", for_clause, ")", block_statement ;

for_clause =
      for_in_clause
    | for_control_clause ;

for_in_clause =
    ( "let" | "var" ), binding_pattern, ":", type, "in", expression ;

for_control_clause =
    [ for_initializer ], ";", [ expression ], ";", [ for_update ] ;

for_initializer =
      binding_declaration
    | ( assignment | expression ),
      { ",", ( assignment | expression ) } ;

for_update =
    ( assignment | expression ),
    { ",", ( assignment | expression ) } ;

break_statement =
    "break", ";" ;

continue_statement =
    "continue", ";" ;

return_statement =
    "return", [ expression ], ";" ;

defer_statement =
    "defer", ( expression, ";" | assignment, ";" | block_statement ) ;

binding_declaration =
    binding_kind, binding_pattern, ":", type, "=", expression ;

binding_kind =
      "let"
    | "var"
    | "const" ;

binding_pattern =
      identifier
    | "_"
    | tuple_binding_pattern ;

tuple_binding_pattern =
    "(", binding_pattern, ",", binding_pattern,
    { ",", binding_pattern }, ")" ;

binding_statement =
    [ access_modifier ], binding_declaration, ";" ;
