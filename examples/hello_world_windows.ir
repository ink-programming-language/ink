source_filename = "main"
; On Windows x64, the array address points to the first byte and u64 0 supplies the null OVERLAPPED pointer bits.
declare public import c ptr<void> @f0 "GetStdHandle"(u32 %a0 "StandardHandle")
declare public import c i32 @f1 "WriteFile"(ptr<void> %a1 "File", ptr<[14 x u8]> %a2 "Buffer", u32 %a3 "BytesToWrite", ptr<u32> %a4 "BytesWritten", u64 %a5 "Overlapped")
define public export i32 @f2 "main"()
{
  %bb0 "entry":
    %v0 = call ptr<void> @f0(u32 4294967285)
    %v1 = alloca [14 x u8]
    store [14 x u8] c"hello, world\0D\0A", ptr<[14 x u8]> %v1
    %v2 = alloca u32
    store u32 0, ptr<u32> %v2
    %v3 = call i32 @f1(ptr<void> %v0, ptr<[14 x u8]> %v1, u32 14, ptr<u32> %v2, u64 0)
    ret i32 %v3
}
