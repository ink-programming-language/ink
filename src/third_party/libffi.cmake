set(INK_LIBFFI_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/libffi")
set(INK_LIBFFI_BINARY_DIR "${CMAKE_BINARY_DIR}/third_party/libffi")
set(INK_LIBFFI_INCLUDE_DIR "${INK_LIBFFI_BINARY_DIR}/include")
file(MAKE_DIRECTORY "${INK_LIBFFI_INCLUDE_DIR}")

set(VERSION "3.8.0")
set(FFI_VERSION_STRING "3.8.0")
set(FFI_VERSION_NUMBER "30800")
set(FFI_EXEC_TRAMPOLINE_TABLE "0")

if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64)$")
  set(TARGET "X86_WIN64")
  set(HAVE_LONG_DOUBLE "0")
  set(INK_LIBFFI_SIZEOF_LONG_DOUBLE "8")
  set(INK_LIBFFI_HAVE_AS_CFI_PSEUDO_OP "0")
  set(INK_LIBFFI_HAVE_AS_X86_PCREL "0")
  set(INK_LIBFFI_HAVE_INT128 "0")
  set(INK_LIBFFI_TARGET_SOURCES "${INK_LIBFFI_SOURCE_DIR}/src/x86/ffiw64.c")
elseif(UNIX AND NOT APPLE AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64)$")
  enable_language(ASM)
  set(TARGET "X86_64")
  set(HAVE_LONG_DOUBLE "1")
  set(INK_LIBFFI_SIZEOF_LONG_DOUBLE "16")
  set(INK_LIBFFI_HAVE_AS_CFI_PSEUDO_OP "1")
  set(INK_LIBFFI_HAVE_AS_X86_PCREL "1")
  set(INK_LIBFFI_HAVE_INT128 "1")
  set(INK_LIBFFI_TARGET_SOURCES "${INK_LIBFFI_SOURCE_DIR}/src/x86/ffi64.c" "${INK_LIBFFI_SOURCE_DIR}/src/x86/unix64.S")
else()
  message(FATAL_ERROR "The bundled libffi adapter currently supports Windows x64 and Linux x86-64")
endif()

configure_file("${INK_LIBFFI_SOURCE_DIR}/include/ffi.h.in" "${INK_LIBFFI_INCLUDE_DIR}/ffi.h" @ONLY)
configure_file("${PROJECT_SOURCE_DIR}/cmake/libffi-fficonfig.h.in" "${INK_LIBFFI_INCLUDE_DIR}/fficonfig.h" @ONLY)

if(WIN32)
  enable_language(ASM_MASM)
  set(INK_LIBFFI_WIN64_ASSEMBLY "${INK_LIBFFI_BINARY_DIR}/win64_intel.asm")
  add_custom_command(OUTPUT "${INK_LIBFFI_WIN64_ASSEMBLY}" COMMAND "${CMAKE_COMMAND}" "-DINK_LIBFFI_C_COMPILER=${CMAKE_C_COMPILER}" "-DINK_LIBFFI_SOURCE=${INK_LIBFFI_SOURCE_DIR}/src/x86/win64_intel.S" "-DINK_LIBFFI_OUTPUT=${INK_LIBFFI_WIN64_ASSEMBLY}" "-DINK_LIBFFI_GENERATED_INCLUDE=${INK_LIBFFI_INCLUDE_DIR}" "-DINK_LIBFFI_SOURCE_INCLUDE=${INK_LIBFFI_SOURCE_DIR}/include" "-DINK_LIBFFI_TARGET_INCLUDE=${INK_LIBFFI_SOURCE_DIR}/src/x86" -P "${PROJECT_SOURCE_DIR}/cmake/InkPreprocessLibffiAssembly.cmake" DEPENDS "${INK_LIBFFI_SOURCE_DIR}/src/x86/win64_intel.S" "${INK_LIBFFI_INCLUDE_DIR}/ffi.h" "${INK_LIBFFI_INCLUDE_DIR}/fficonfig.h" "${INK_LIBFFI_SOURCE_DIR}/include/ffi_cfi.h" "${INK_LIBFFI_SOURCE_DIR}/src/x86/asmnames.h" VERBATIM)
  list(APPEND INK_LIBFFI_TARGET_SOURCES "${INK_LIBFFI_WIN64_ASSEMBLY}")
  set_source_files_properties("${INK_LIBFFI_WIN64_ASSEMBLY}" PROPERTIES GENERATED TRUE LANGUAGE ASM_MASM)
endif()

add_library(ink_libffi STATIC "${INK_LIBFFI_SOURCE_DIR}/src/prep_cif.c" "${INK_LIBFFI_SOURCE_DIR}/src/types.c" ${INK_LIBFFI_TARGET_SOURCES})
add_library(ink::libffi ALIAS ink_libffi)
target_compile_definitions(ink_libffi PUBLIC FFI_STATIC_BUILD)
target_include_directories(ink_libffi PUBLIC "${INK_LIBFFI_INCLUDE_DIR}" "${INK_LIBFFI_SOURCE_DIR}/src/x86" PRIVATE "${INK_LIBFFI_SOURCE_DIR}/include")
set_target_properties(ink_libffi PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES POSITION_INDEPENDENT_CODE YES)

if(MSVC)
  target_compile_options(ink_libffi PRIVATE "$<$<COMPILE_LANGUAGE:C>:/wd4244>" "$<$<COMPILE_LANGUAGE:C>:/wd4267>")
endif()
