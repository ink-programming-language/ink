#ifndef INK_IR_RECORD
#error "Define INK_IR_RECORD before including Record.def"
#endif

// INK_IR_RECORD(Kind, WireId, Category, Name, TextName, Layout)
// Wire IDs are explicit and independent of native ValueKind and declaration order.
// TextName is empty when the grammar uses contextual syntax instead of one token.
// Intentionally included more than once.
INK_IR_RECORD(Module, 1, Other, "module", "module", Module)
INK_IR_RECORD(BoolType, 10, Type, "type.bool", "bool", BoolType)
INK_IR_RECORD(IntegerType, 11, Type, "type.integer", "", IntegerType)
INK_IR_RECORD(FloatType, 12, Type, "type.float", "f", FloatType)
INK_IR_RECORD(VoidType, 13, Type, "type.void", "void", VoidType)
INK_IR_RECORD(NullPointerType, 14, Type, "type.nullptr", "nullptr", NullPointerType)
INK_IR_RECORD(MetaType, 15, Type, "type.meta", "meta", MetaType)
INK_IR_RECORD(VariadicType, 16, Type, "type.variadic", "variadic", VariadicType)
INK_IR_RECORD(PointerType, 17, Type, "type.pointer", "*", PointerType)
INK_IR_RECORD(ReferenceType, 18, Type, "type.reference", "&", ReferenceType)
INK_IR_RECORD(ArrayType, 19, Type, "type.array", "[", ArrayType)
INK_IR_RECORD(FunctionType, 20, Type, "type.function", "fn", FunctionType)
INK_IR_RECORD(ClassType, 21, Nominal, "type.class", "class", ClassType)
INK_IR_RECORD(InterfaceType, 22, Nominal, "type.interface", "interface", InterfaceType)
INK_IR_RECORD(StructType, 23, Nominal, "type.struct", "struct", StructType)
INK_IR_RECORD(QualifiedType, 24, Type, "type.qualified", "const", QualifiedType)
INK_IR_RECORD(Field, 30, Other, "field", "field", Field)
INK_IR_RECORD(Function, 31, Other, "define", "define", Function)
INK_IR_RECORD(Parameter, 32, Other, "parameter", "", Parameter)
INK_IR_RECORD(Block, 33, Other, "block", "", Block)
INK_IR_RECORD(Global, 34, Other, "global", "global", Global)
INK_IR_RECORD(Import, 35, Other, "import", "import", Import)
INK_IR_RECORD(Export, 36, Other, "export", "export", Export)
INK_IR_RECORD(BoolConstant, 40, Constant, "const.bool", "", BoolConstant)
INK_IR_RECORD(IntegerConstant, 41, Constant, "const.integer", "", IntegerConstant)
INK_IR_RECORD(FloatConstant, 42, Constant, "const.float", "bits", FloatConstant)
INK_IR_RECORD(NullPointerConstant, 43, Constant, "const.nullptr", "null", NullPointerConstant)
INK_IR_RECORD(StringConstant, 44, Constant, "const.string", "c", StringConstant)
INK_IR_RECORD(ArrayConstant, 45, Constant, "const.array", "[", ArrayConstant)
INK_IR_RECORD(Alloca, 60, Instruction, "alloca", "alloca", Alloca)
INK_IR_RECORD(Load, 61, Instruction, "load", "load", Load)
INK_IR_RECORD(Store, 62, Instruction, "store", "store", Store)
INK_IR_RECORD(Neg, 63, Instruction, "neg", "neg", Neg)
INK_IR_RECORD(ICmp, 64, Instruction, "icmp", "icmp", ICmp)
INK_IR_RECORD(Branch, 65, Instruction, "br", "br", Branch)
INK_IR_RECORD(CondBranch, 66, Instruction, "br_if", "br_if", CondBranch)
INK_IR_RECORD(Return, 67, Instruction, "ret", "ret", Return)
INK_IR_RECORD(Call, 68, Instruction, "call", "call", Call)
INK_IR_RECORD(GetElementPtr, 69, Instruction, "getelementptr", "getelementptr", GetElementPtr)
