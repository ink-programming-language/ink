// Constructor-order field schema. Changing a field or its order requires an archive version bump.
// Node types must also be registered in ASTNodes.def. All getters are evaluated on const objects.
AST_FIELDS(Parameter, Value.name(), Value.type(), Value.defaultValue(), Value.variadic(), Value.range())
AST_FIELDS(FunctionTypeParameter, Value.name(), Value.type(), Value.variadic(), Value.range())
AST_FIELDS(Argument, Value.form(), Value.name(), Value.value(), Value.range())
AST_FIELDS(PathSegment, Value.name(), Value.hasGenericArguments(), Value.arguments(), Value.range())
AST_FIELDS(Attribute, Value.path(), Value.suffix(), Value.arguments(), Value.value(), Value.range())
AST_FIELDS(BaseSpec, Value.implements(), Value.type(), Value.range())
AST_FIELDS(MatchArm, Value.pattern(), Value.guard(), Value.value(), Value.range())
AST_FIELDS(SwitchClause, Value.isDefault(), Value.value(), Value.statements(), Value.range())
AST_FIELDS(ImportEntry, Value.path(), Value.alias(), Value.range())
AST_FIELDS(ModuleAST, Value.getSourceRange(), Value.statements())
AST_FIELDS(TypeSyntax, Value.getSourceRange(), Value.expression())
