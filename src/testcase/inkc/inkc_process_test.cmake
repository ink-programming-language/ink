if(NOT DEFINED INK_COMPILER OR NOT DEFINED INK_TEST_DIRECTORY)
  message(FATAL_ERROR "InkCompilerProcessTest requires INK_COMPILER and INK_TEST_DIRECTORY")
endif()

file(REMOVE_RECURSE "${INK_TEST_DIRECTORY}")
file(MAKE_DIRECTORY "${INK_TEST_DIRECTORY}")
set(INK_TEST_SOURCE "${INK_TEST_DIRECTORY}/std-program.ink")
if(WIN32)
  set(INK_TEST_EXECUTABLE "${INK_TEST_DIRECTORY}/std-program.exe")
else()
  set(INK_TEST_EXECUTABLE "${INK_TEST_DIRECTORY}/std-program")
endif()
file(WRITE "${INK_TEST_SOURCE}" "import std.int as integers;\nfunc max(Left: i32, Right: i32) -> i32 { return Left - Right; }\nfunc main() -> i32 { if (integers.clamp(50, 0, 42) == 42 && integers.min(7, 9) == 7 && max(9, 4) == 5) { return 0; } else { return 5; } }\n")

set(INK_INVALID_ENTRY_SOURCE "${INK_TEST_DIRECTORY}/missing-main.ink")
file(WRITE "${INK_INVALID_ENTRY_SOURCE}" "func helper() -> i32 { return 0; }\n")
execute_process(COMMAND "${INK_COMPILER}" --interpret "${INK_INVALID_ENTRY_SOURCE}" WORKING_DIRECTORY "${INK_TEST_DIRECTORY}" RESULT_VARIABLE INK_INVALID_ENTRY_RESULT OUTPUT_VARIABLE INK_INVALID_ENTRY_STDOUT ERROR_VARIABLE INK_INVALID_ENTRY_STDERR)
if(NOT INK_INVALID_ENTRY_RESULT EQUAL 1)
  message(FATAL_ERROR "inkc missing-entry diagnostic returned ${INK_INVALID_ENTRY_RESULT} instead of 1\nstdout:\n${INK_INVALID_ENTRY_STDOUT}\nstderr:\n${INK_INVALID_ENTRY_STDERR}")
endif()
if(NOT INK_INVALID_ENTRY_STDOUT STREQUAL "" OR NOT INK_INVALID_ENTRY_STDERR MATCHES "error\\[INK-D0001\\]")
  message(FATAL_ERROR "inkc missing-entry failure did not use the shared stable diagnostic\nstdout:\n${INK_INVALID_ENTRY_STDOUT}\nstderr:\n${INK_INVALID_ENTRY_STDERR}")
endif()

set(INK_INVALID_SOURCE "${INK_TEST_DIRECTORY}/invalid-source.ink")
file(WRITE "${INK_INVALID_SOURCE}" "func main() -> i32 { return 0 }\n")
execute_process(COMMAND "${INK_COMPILER}" --interpret "${INK_INVALID_SOURCE}" WORKING_DIRECTORY "${INK_TEST_DIRECTORY}" RESULT_VARIABLE INK_INVALID_SOURCE_RESULT OUTPUT_VARIABLE INK_INVALID_SOURCE_STDOUT ERROR_VARIABLE INK_INVALID_SOURCE_STDERR)
if(NOT INK_INVALID_SOURCE_RESULT EQUAL 1)
  message(FATAL_ERROR "inkc source diagnostic returned ${INK_INVALID_SOURCE_RESULT} instead of 1\nstdout:\n${INK_INVALID_SOURCE_STDOUT}\nstderr:\n${INK_INVALID_SOURCE_STDERR}")
endif()
if(NOT INK_INVALID_SOURCE_STDOUT STREQUAL "" OR NOT INK_INVALID_SOURCE_STDERR MATCHES "error\\[INK-P[0-9]+\\]")
  message(FATAL_ERROR "inkc frontend failure did not flow through the shared source diagnostic consumer\nstdout:\n${INK_INVALID_SOURCE_STDOUT}\nstderr:\n${INK_INVALID_SOURCE_STDERR}")
endif()

set(INK_TRAP_SOURCE "${INK_TEST_DIRECTORY}/runtime-trap.ink")
file(WRITE "${INK_TRAP_SOURCE}" "func trap() -> never;\nfunc main() -> i32 { trap(); }\n")
execute_process(COMMAND "${INK_COMPILER}" --interpret "${INK_TRAP_SOURCE}" WORKING_DIRECTORY "${INK_TEST_DIRECTORY}" RESULT_VARIABLE INK_TRAP_RESULT OUTPUT_VARIABLE INK_TRAP_STDOUT ERROR_VARIABLE INK_TRAP_STDERR)
if(NOT INK_TRAP_RESULT EQUAL 1)
  message(FATAL_ERROR "inkc runtime trap returned ${INK_TRAP_RESULT} instead of 1\nstdout:\n${INK_TRAP_STDOUT}\nstderr:\n${INK_TRAP_STDERR}")
endif()
if(NOT INK_TRAP_STDOUT STREQUAL "" OR NOT INK_TRAP_STDERR MATCHES "error\\[INK-R0001\\]")
  message(FATAL_ERROR "inkc runtime trap did not flow through the shared runtime diagnostic consumer\nstdout:\n${INK_TRAP_STDOUT}\nstderr:\n${INK_TRAP_STDERR}")
endif()

execute_process(COMMAND "${INK_COMPILER}" --interpret "${INK_TEST_SOURCE}" WORKING_DIRECTORY "${INK_TEST_DIRECTORY}" RESULT_VARIABLE INK_INTERPRET_RESULT OUTPUT_VARIABLE INK_INTERPRET_STDOUT ERROR_VARIABLE INK_INTERPRET_STDERR)
if(NOT INK_INTERPRET_RESULT EQUAL 0)
  message(FATAL_ERROR "inkc interpretation failed with ${INK_INTERPRET_RESULT}\nstdout:\n${INK_INTERPRET_STDOUT}\nstderr:\n${INK_INTERPRET_STDERR}")
endif()
if(NOT INK_INTERPRET_STDOUT STREQUAL "" OR NOT INK_INTERPRET_STDERR STREQUAL "")
  message(FATAL_ERROR "successful inkc interpretation must be silent\nstdout:\n${INK_INTERPRET_STDOUT}\nstderr:\n${INK_INTERPRET_STDERR}")
endif()

execute_process(COMMAND "${INK_COMPILER}" --aot -o "${INK_TEST_EXECUTABLE}" "${INK_TEST_SOURCE}" WORKING_DIRECTORY "${INK_TEST_DIRECTORY}" RESULT_VARIABLE INK_AOT_RESULT OUTPUT_VARIABLE INK_AOT_STDOUT ERROR_VARIABLE INK_AOT_STDERR)
if(NOT INK_AOT_RESULT EQUAL 0)
  message(FATAL_ERROR "inkc AOT compilation failed with ${INK_AOT_RESULT}\nstdout:\n${INK_AOT_STDOUT}\nstderr:\n${INK_AOT_STDERR}")
endif()
if(NOT INK_AOT_STDOUT STREQUAL "" OR NOT INK_AOT_STDERR STREQUAL "")
  message(FATAL_ERROR "successful inkc AOT compilation must be silent\nstdout:\n${INK_AOT_STDOUT}\nstderr:\n${INK_AOT_STDERR}")
endif()
if(NOT EXISTS "${INK_TEST_EXECUTABLE}")
  message(FATAL_ERROR "inkc reported AOT success without creating the executable")
endif()

execute_process(COMMAND "${INK_TEST_EXECUTABLE}" WORKING_DIRECTORY "${INK_TEST_DIRECTORY}" RESULT_VARIABLE INK_EXECUTABLE_RESULT OUTPUT_VARIABLE INK_EXECUTABLE_STDOUT ERROR_VARIABLE INK_EXECUTABLE_STDERR)
if(NOT INK_EXECUTABLE_RESULT EQUAL 0)
  message(FATAL_ERROR "inkc AOT executable failed with ${INK_EXECUTABLE_RESULT}\nstdout:\n${INK_EXECUTABLE_STDOUT}\nstderr:\n${INK_EXECUTABLE_STDERR}")
endif()
if(NOT INK_EXECUTABLE_STDOUT STREQUAL "" OR NOT INK_EXECUTABLE_STDERR STREQUAL "")
  message(FATAL_ERROR "successful inkc AOT executable must be silent\nstdout:\n${INK_EXECUTABLE_STDOUT}\nstderr:\n${INK_EXECUTABLE_STDERR}")
endif()

set(INK_IO_SOURCE "${INK_TEST_DIRECTORY}/io-program.ink")
if(WIN32)
  set(INK_IO_EXECUTABLE "${INK_TEST_DIRECTORY}/io-program.exe")
else()
  set(INK_IO_EXECUTABLE "${INK_TEST_DIRECTORY}/io-program")
endif()
file(WRITE "${INK_IO_SOURCE}" [=[import std.io as io;
func main() -> i32
{
  io.output("Hello, world!\n");
  return 0;
}
]=])
set(INK_EXPECTED_OUTPUT "Hello, world!\n")

execute_process(COMMAND "${INK_COMPILER}" "${INK_IO_SOURCE}" --interpret WORKING_DIRECTORY "${INK_TEST_DIRECTORY}" RESULT_VARIABLE INK_IO_INTERPRET_RESULT OUTPUT_VARIABLE INK_IO_INTERPRET_STDOUT ERROR_VARIABLE INK_IO_INTERPRET_STDERR)
if(NOT INK_IO_INTERPRET_RESULT EQUAL 0 OR NOT INK_IO_INTERPRET_STDOUT STREQUAL INK_EXPECTED_OUTPUT OR NOT INK_IO_INTERPRET_STDERR STREQUAL "")
  message(FATAL_ERROR "inkc did not interpret std.io.output correctly\nresult: ${INK_IO_INTERPRET_RESULT}\nstdout:\n${INK_IO_INTERPRET_STDOUT}\nstderr:\n${INK_IO_INTERPRET_STDERR}")
endif()

execute_process(COMMAND "${INK_COMPILER}" "${INK_IO_SOURCE}" -o "${INK_IO_EXECUTABLE}" --aot WORKING_DIRECTORY "${INK_TEST_DIRECTORY}" RESULT_VARIABLE INK_IO_AOT_RESULT OUTPUT_VARIABLE INK_IO_AOT_STDOUT ERROR_VARIABLE INK_IO_AOT_STDERR)
if(NOT INK_IO_AOT_RESULT EQUAL 0 OR NOT INK_IO_AOT_STDOUT STREQUAL "" OR NOT INK_IO_AOT_STDERR STREQUAL "" OR NOT EXISTS "${INK_IO_EXECUTABLE}")
  message(FATAL_ERROR "inkc did not compile std.io.output to an AOT executable\nresult: ${INK_IO_AOT_RESULT}\nstdout:\n${INK_IO_AOT_STDOUT}\nstderr:\n${INK_IO_AOT_STDERR}")
endif()

execute_process(COMMAND "${INK_IO_EXECUTABLE}" WORKING_DIRECTORY "${INK_TEST_DIRECTORY}" RESULT_VARIABLE INK_IO_EXECUTABLE_RESULT OUTPUT_VARIABLE INK_IO_EXECUTABLE_STDOUT ERROR_VARIABLE INK_IO_EXECUTABLE_STDERR)
if(NOT INK_IO_EXECUTABLE_RESULT EQUAL 0 OR NOT INK_IO_EXECUTABLE_STDOUT STREQUAL INK_EXPECTED_OUTPUT OR NOT INK_IO_EXECUTABLE_STDERR STREQUAL "")
  message(FATAL_ERROR "inkc AOT executable did not run std.io.output correctly\nresult: ${INK_IO_EXECUTABLE_RESULT}\nstdout:\n${INK_IO_EXECUTABLE_STDOUT}\nstderr:\n${INK_IO_EXECUTABLE_STDERR}")
endif()
