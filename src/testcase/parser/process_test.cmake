if(NOT DEFINED INK_PARSER OR NOT DEFINED INK_TEST_DIRECTORY)
  message(FATAL_ERROR "Parser executable and test directory are required")
endif()
file(MAKE_DIRECTORY "${INK_TEST_DIRECTORY}")
set(Input "${INK_TEST_DIRECTORY}/source input.ink")
file(WRITE "${Input}" "[tag] func f(x: int): int { return x + 1; }")
execute_process(COMMAND "${INK_PARSER}" "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE Output ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status EQUAL 0 OR NOT Error STREQUAL "" OR NOT Output MATCHES "FunctionDecl" OR NOT Output MATCHES "BinaryExpr")
  message(FATAL_ERROR "Valid parser input failed: ${Status}: ${Output}: ${Error}")
endif()
execute_process(COMMAND "${INK_PARSER}" "-" INPUT_FILE "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE StdinOutput ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status EQUAL 0 OR NOT Error STREQUAL "" OR NOT StdinOutput STREQUAL Output)
  message(FATAL_ERROR "Standard input AST differs from file input: ${Status}: ${Error}")
endif()

# Omitting the path or ending option parsing without a path must read standard input.
execute_process(COMMAND "${INK_PARSER}" INPUT_FILE "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE StdinOutput ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT StdinOutput STREQUAL Output)
  message(FATAL_ERROR "Default standard input AST differs from file input: ${Status}: ${StdinOutput}: ${Error}")
endif()
execute_process(COMMAND "${INK_PARSER}" "--" INPUT_FILE "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE StdinOutput ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT StdinOutput STREQUAL Output)
  message(FATAL_ERROR "Standard input after -- differs from file input: ${Status}: ${StdinOutput}: ${Error}")
endif()
execute_process(COMMAND "${INK_PARSER}" "--" "-" INPUT_FILE "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE StdinOutput ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT StdinOutput STREQUAL Output)
  message(FATAL_ERROR "Explicit standard input after -- differs from file input: ${Status}: ${StdinOutput}: ${Error}")
endif()

# The option terminator must preserve paths with spaces and hyphen-leading filenames.
execute_process(COMMAND "${INK_PARSER}" "--" "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE FileOutput ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT FileOutput STREQUAL Output)
  message(FATAL_ERROR "File path with spaces after -- changed parser output: ${Status}: ${FileOutput}: ${Error}")
endif()
configure_file("${Input}" "${INK_TEST_DIRECTORY}/-source.ink" COPYONLY)
execute_process(COMMAND "${INK_PARSER}" "--" "-source.ink" WORKING_DIRECTORY "${INK_TEST_DIRECTORY}" RESULT_VARIABLE Status OUTPUT_VARIABLE FileOutput ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT FileOutput STREQUAL Output)
  message(FATAL_ERROR "Hyphen-leading file path failed: ${Status}: ${FileOutput}: ${Error}")
endif()

# Help and version must exit successfully without consuming standard input or writing diagnostics.
foreach(Option IN ITEMS "-h" "--help")
  execute_process(COMMAND "${INK_PARSER}" "${Option}" RESULT_VARIABLE Status OUTPUT_VARIABLE Information ERROR_VARIABLE Error TIMEOUT 10)
  if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT Information MATCHES "ink-parse" OR NOT Information MATCHES "--help")
    message(FATAL_ERROR "Parser help failed for ${Option}: ${Status}: ${Information}: ${Error}")
  endif()
endforeach()
foreach(Option IN ITEMS "-V" "--version")
  execute_process(COMMAND "${INK_PARSER}" "${Option}" RESULT_VARIABLE Status OUTPUT_VARIABLE Information ERROR_VARIABLE Error TIMEOUT 10)
  if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT Information MATCHES "ink-parse development")
    message(FATAL_ERROR "Parser version failed for ${Option}: ${Status}: ${Information}: ${Error}")
  endif()
endforeach()

# Invalid options must return the invocation status through the tool's stderr diagnostic path.
foreach(Option IN ITEMS "--unknown" "-x" "--help=value" "--version=value" "--help=" "--version=" "--h=value" "--V=value")
  execute_process(COMMAND "${INK_PARSER}" "${Option}" RESULT_VARIABLE Status OUTPUT_VARIABLE Information ERROR_VARIABLE Error TIMEOUT 10)
  if(NOT Status STREQUAL "2" OR NOT Information STREQUAL "" OR NOT Error MATCHES "ink-parse: error:")
    message(FATAL_ERROR "Parser option failure was not reported correctly for ${Option}: ${Status}: ${Information}: ${Error}")
  endif()
endforeach()

# A second source path and an explicitly empty path must be rejected before reading any source.
execute_process(COMMAND "${INK_PARSER}" "${Input}" "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE Information ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "2" OR NOT Information STREQUAL "" OR NOT Error MATCHES "ink-parse: error:")
  message(FATAL_ERROR "Duplicate parser input was not rejected: ${Status}: ${Information}: ${Error}")
endif()
execute_process(COMMAND "${INK_PARSER}" "" RESULT_VARIABLE Status OUTPUT_VARIABLE Information ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "2" OR NOT Information STREQUAL "" OR NOT Error MATCHES "ink-parse: error:")
  message(FATAL_ERROR "Empty parser input argument was not rejected: ${Status}: ${Information}: ${Error}")
endif()

# Help and version remain mutually exclusive instead of silently choosing one action.
execute_process(COMMAND "${INK_PARSER}" "--help" "--version" RESULT_VARIABLE Status OUTPUT_VARIABLE Information ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "2" OR NOT Information STREQUAL "" OR NOT Error MATCHES "ink-parse: error:")
  message(FATAL_ERROR "Conflicting parser information options were not rejected: ${Status}: ${Information}: ${Error}")
endif()

file(WRITE "${Input}" "var a = 1\nvar b = f(2, , 4);")
execute_process(COMMAND "${INK_PARSER}" "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE Output ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status EQUAL 1 OR NOT Error MATCHES "INK-P0001" OR NOT Error MATCHES "INK-P0002" OR NOT Output MATCHES "MissingExpr" OR NOT Output MATCHES "status=inserted")
  message(FATAL_ERROR "Recovery output or exit status is wrong: ${Status}: ${Output}: ${Error}")
endif()
file(WRITE "${Input}" "@")
execute_process(COMMAND "${INK_PARSER}" "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE Output ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status EQUAL 1 OR NOT Error MATCHES "INK-T0004" OR Error MATCHES "INK-P")
  message(FATAL_ERROR "Lexical errors must not be re-diagnosed by the parser: ${Status}: ${Error}")
endif()
file(WRITE "${Input}" "")
execute_process(COMMAND "${INK_PARSER}" "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE Output ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status EQUAL 0 OR NOT Output MATCHES "ModuleAST \\[0, 0\\)")
  message(FATAL_ERROR "Empty module failed: ${Status}: ${Output}: ${Error}")
endif()
execute_process(COMMAND "${INK_PARSER}" "${INK_TEST_DIRECTORY}/does-not-exist.ink" RESULT_VARIABLE Status OUTPUT_VARIABLE Output ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status EQUAL 2 OR NOT Error MATCHES "cannot open")
  message(FATAL_ERROR "Missing input should report invocation failure: ${Status}: ${Error}")
endif()
