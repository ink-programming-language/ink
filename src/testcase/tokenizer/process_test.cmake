if(NOT DEFINED INK_TOKENIZER OR NOT DEFINED INK_TEST_DIRECTORY)
  message(FATAL_ERROR "Tokenizer executable and test directory are required")
endif()

file(MAKE_DIRECTORY "${INK_TEST_DIRECTORY}")
set(Input "${INK_TEST_DIRECTORY}/source input.ink")
file(WRITE "${Input}" "var x = '\\U0001F600'; // ignored\r\nr\"a\\\"")
execute_process(COMMAND "${INK_TOKENIZER}" "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE Output ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status EQUAL 0 OR NOT Error STREQUAL "")
  message(FATAL_ERROR "Valid source failed: ${Status}: ${Error}")
endif()
foreach(Kind IN ITEMS KW_VAR IDENTIFIER ASSIGN CHAR_LITERAL SEMICOLON STRING_LITERAL END_OF_FILE)
  if(NOT Output MATCHES "${Kind} \\[")
    message(FATAL_ERROR "Missing ${Kind} in tokenizer output: ${Output}")
  endif()
endforeach()
if(Output MATCHES "COMMENT|LINE_BREAK|SPACES")
  message(FATAL_ERROR "Trivia must not be emitted: ${Output}")
endif()

# Omitting the path, using '-', or ending option parsing without a path must read standard input.
execute_process(COMMAND "${INK_TOKENIZER}" INPUT_FILE "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE StdinOutput ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT StdinOutput STREQUAL Output)
  message(FATAL_ERROR "Default standard input tokens differ from file input: ${Status}: ${StdinOutput}: ${Error}")
endif()
foreach(Argument IN ITEMS "-" "--")
  execute_process(COMMAND "${INK_TOKENIZER}" "${Argument}" INPUT_FILE "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE StdinOutput ERROR_VARIABLE Error TIMEOUT 10)
  if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT StdinOutput STREQUAL Output)
    message(FATAL_ERROR "Standard input tokens differ for ${Argument}: ${Status}: ${StdinOutput}: ${Error}")
  endif()
endforeach()
execute_process(COMMAND "${INK_TOKENIZER}" "--" "-" INPUT_FILE "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE StdinOutput ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT StdinOutput STREQUAL Output)
  message(FATAL_ERROR "Explicit standard input after -- differs from file input: ${Status}: ${StdinOutput}: ${Error}")
endif()

# The option terminator must preserve paths with spaces and hyphen-leading filenames.
execute_process(COMMAND "${INK_TOKENIZER}" "--" "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE FileOutput ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT FileOutput STREQUAL Output)
  message(FATAL_ERROR "File path with spaces after -- changed tokenizer output: ${Status}: ${FileOutput}: ${Error}")
endif()
configure_file("${Input}" "${INK_TEST_DIRECTORY}/-source.ink" COPYONLY)
execute_process(COMMAND "${INK_TOKENIZER}" "--" "-source.ink" WORKING_DIRECTORY "${INK_TEST_DIRECTORY}" RESULT_VARIABLE Status OUTPUT_VARIABLE FileOutput ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT FileOutput STREQUAL Output)
  message(FATAL_ERROR "Hyphen-leading file path failed: ${Status}: ${FileOutput}: ${Error}")
endif()

# Help and version must exit successfully without consuming standard input or writing diagnostics.
foreach(Option IN ITEMS "-h" "--help")
  execute_process(COMMAND "${INK_TOKENIZER}" "${Option}" RESULT_VARIABLE Status OUTPUT_VARIABLE Information ERROR_VARIABLE Error TIMEOUT 10)
  if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT Information MATCHES "ink-tokenize" OR NOT Information MATCHES "--help")
    message(FATAL_ERROR "Tokenizer help failed for ${Option}: ${Status}: ${Information}: ${Error}")
  endif()
endforeach()
foreach(Option IN ITEMS "-V" "--version")
  execute_process(COMMAND "${INK_TOKENIZER}" "${Option}" RESULT_VARIABLE Status OUTPUT_VARIABLE Information ERROR_VARIABLE Error TIMEOUT 10)
  if(NOT Status STREQUAL "0" OR NOT Error STREQUAL "" OR NOT Information MATCHES "ink-tokenize development")
    message(FATAL_ERROR "Tokenizer version failed for ${Option}: ${Status}: ${Information}: ${Error}")
  endif()
endforeach()

# Invalid options must return the invocation status through the tool's stderr diagnostic path.
foreach(Option IN ITEMS "--unknown" "-x" "--help=value" "--version=value" "--help=" "--version=" "--h=value" "--V=value")
  execute_process(COMMAND "${INK_TOKENIZER}" "${Option}" RESULT_VARIABLE Status OUTPUT_VARIABLE Information ERROR_VARIABLE Error TIMEOUT 10)
  if(NOT Status STREQUAL "2" OR NOT Information STREQUAL "" OR NOT Error MATCHES "ink-tokenize: error:")
    message(FATAL_ERROR "Tokenizer option failure was not reported correctly for ${Option}: ${Status}: ${Information}: ${Error}")
  endif()
endforeach()

# A second source path and an explicitly empty path must be rejected before reading any source.
execute_process(COMMAND "${INK_TOKENIZER}" "${Input}" "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE Information ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "2" OR NOT Information STREQUAL "" OR NOT Error MATCHES "ink-tokenize: error:")
  message(FATAL_ERROR "Duplicate tokenizer input was not rejected: ${Status}: ${Information}: ${Error}")
endif()
execute_process(COMMAND "${INK_TOKENIZER}" "" RESULT_VARIABLE Status OUTPUT_VARIABLE Information ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "2" OR NOT Information STREQUAL "" OR NOT Error MATCHES "ink-tokenize: error:")
  message(FATAL_ERROR "Empty tokenizer input argument was not rejected: ${Status}: ${Information}: ${Error}")
endif()

# Help and version remain mutually exclusive instead of silently choosing one action.
execute_process(COMMAND "${INK_TOKENIZER}" "--help" "--version" RESULT_VARIABLE Status OUTPUT_VARIABLE Information ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status STREQUAL "2" OR NOT Information STREQUAL "" OR NOT Error MATCHES "ink-tokenize: error:")
  message(FATAL_ERROR "Conflicting tokenizer information options were not rejected: ${Status}: ${Information}: ${Error}")
endif()

file(WRITE "${Input}" "1_000")
execute_process(COMMAND "${INK_TOKENIZER}" "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE Output ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status EQUAL 1 OR NOT Error MATCHES "INK-T0008" OR NOT Error MATCHES "\\[0, 5\\)")
  message(FATAL_ERROR "Numeric error did not report its code and original byte range: ${Status}: ${Error}")
endif()
if(Output MATCHES "INTEGER_LITERAL|END_OF_FILE")
  message(FATAL_ERROR "Invalid number was split into valid tokens: ${Output}")
endif()

file(WRITE "${Input}" "")
execute_process(COMMAND "${INK_TOKENIZER}" "${Input}" RESULT_VARIABLE Status OUTPUT_VARIABLE Output ERROR_VARIABLE Error TIMEOUT 10)
if(NOT Status EQUAL 0 OR NOT Output MATCHES "END_OF_FILE \\[0, 0\\)")
  message(FATAL_ERROR "Empty source did not produce EOF: ${Status}: ${Output}: ${Error}")
endif()
