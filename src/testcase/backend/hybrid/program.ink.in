@HELPER@

import "C" func ink_hybrid_clear(): u32;

class Item
{
  field Count: *i32;
  field Weight: i32;

  func __init__(Count: *i32, Weight: i32): void
  {
    this.Count = Count;
    this.Weight = Weight;
  }

  func __del__(): void
  {
    *this.Count = *this.Count + this.Weight;
  }
};

func f(Value: i32): i32
{
  if (Value == 0)
  {
    return @BASE@ + @HELPER_CALL@;
  }
  return bounce(Value + -1) + 1;
}

func bounce(Value: i32): i32
{
  return f(Value) + @STEP@;
}

func copy(Value: Item): Item
{
  return Item(Value.Count, Value.Weight + @EXTRA@);
}

func array(Value: [i32; 2]): [i32; 2]
{
  return [Value[0] + @EXTRA@, Value[1]];
}

public export "C" func hybridValue(Value: i32): i32
{
  return f(Value);
}

public export "C" func hybridLifecycle(): i32
{
  var Count = 0;
  {
    var A = Item(&Count, 3);
    var B = copy(A);
  }
  return Count;
}

public export "C" func hybridArray(): i32
{
  var Values = array([30, 12]);
  return Values[0] + Values[1];
}

public export "C" func hybridBusy(): u32
{
  return ink_hybrid_clear();
}
