# The same source must survive serialization and native code generation at two optimization levels.
function(add_class_aot_test Name Source)
  cmake_parse_arguments(PARSE_ARGV 2 Test "" "STATUS;STDOUT;ERROR" "")
  if(NOT DEFINED Test_STATUS)
    set(Test_STATUS 42)
  endif()
  if(IS_ABSOLUTE "${Source}")
    set(SourcePath "${Source}")
  else()
    set(SourcePath "${CMAKE_CURRENT_SOURCE_DIR}/backend/programs/${Source}")
  endif()
  get_target_property(RuntimeKind ink_aot_runtime MSVC_RUNTIME_LIBRARY)
  if(NOT RuntimeKind)
    set(RuntimeKind "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
  endif()
  add_test(NAME "AOTClassTest.${Name}" COMMAND "${CMAKE_COMMAND}" "-DINK_COMPILER=$<TARGET_FILE:inkc>" "-DINK_CXX_COMPILER=${CMAKE_CXX_COMPILER}" "-DINK_LINKER=${CMAKE_LINKER}" "-DINK_MSVC=${MSVC}" "-DINK_RUNTIME_KIND=${RuntimeKind}" "-DINK_RUNTIME=$<TARGET_FILE:ink_aot_runtime>" "-DINK_LINK_DIRECTORIES=${CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES}" "-DINK_STANDARD_LIBRARIES=${CMAKE_CXX_STANDARD_LIBRARIES}" "-DINK_SOURCE=${SourcePath}" "-DINK_GOLDEN_STATUS=${Test_STATUS}" "-DINK_GOLDEN_OUTPUT=${Test_STDOUT}" "-DINK_GOLDEN_ERROR=${Test_ERROR}" "-DINK_TEST_DIRECTORY=${CMAKE_CURRENT_BINARY_DIR}/class-aot" -P "${CMAKE_CURRENT_SOURCE_DIR}/backend/aot_program_test.cmake")
  set_tests_properties("AOTClassTest.${Name}" PROPERTIES TIMEOUT 120 LABELS "class;aot;differential")
endfunction()

