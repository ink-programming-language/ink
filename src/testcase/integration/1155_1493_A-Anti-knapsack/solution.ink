func main()
{
  var t: dynamic;
  read(t);
  while (cpp_update(t, "--"))
  {
    var n: dynamic;
    var k: dynamic;
    var x: dynamic;
    read(n, k);
    var b = ((n - k));
    var a = (k / 2);
    x = (k + 1);
    write((a + b), "\n");
    k -= 1;
    {
      var i = 1;
      while ((i <= a))
      {
        write(k, " ");
        k -= 1;
        i += 1;
      }
    }
    {
      var i = 1;
      while ((i <= b))
      {
        write(x, " ");
        x += 1;
        i += 1;
      }
    }
    write("\n");
  }
  return 0;
}
