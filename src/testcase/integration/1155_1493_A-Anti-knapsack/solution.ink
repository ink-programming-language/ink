func main() -> dynamic
{
  var t: dynamic = cpp_uninitialized();
  read(t);
  while (cpp_update(t, "--"))
  {
    var n: dynamic = cpp_uninitialized();
    var k: dynamic = cpp_uninitialized();
    var x: dynamic = cpp_uninitialized();
    read(n, k);
    var b: dynamic = ((n - k));
    var a: dynamic = (k / 2);
    x = (k + 1);
    write((a + b), "\n");
    k -= 1;
    {
      var i: dynamic = 1;
      while ((i <= a))
      {
        write(k, " ");
        k -= 1;
        i += 1;
      }
    }
    {
      var i: dynamic = 1;
      while ((i <= b))
      {
        write(x, " ");
        x += 1;
        i += 1;
      }
    }
    write("\n");
  }
  return 0;
}
