{
  return dot(o, l.a, l.b);
}

func dot(l1: dynamic, l2: dynamic)
{
  return dot((l1.b - l1.a), (l2.b - l2.a));
}

func det(x1: dynamic, y1: dynamic, x2: dynamic, y2: dynamic)
{
  return ((x1 * y2) - (x2 * y1));
}

