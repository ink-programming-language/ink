func low_bit(x: dynamic)
{
  return (x & (-x));
}

func high_bit(x: dynamic)
{
  var p = low_bit(x);
  while ((p != x))
  {
    x -= p;
    p = low_bit(x);
  }
  return p;
}

func cover_bit(x: dynamic)
{
  var p = 1;
  while ((p < x))
  {
    p <<= 1;
  }
  return p;
}

func count_bits(x: dynamic)
{
  x = (((x & 0x55555555)) + ((((x & 0xaaaaaaaa)) >> 1)));
  x = (((x & 0x33333333)) + ((((x & 0xcccccccc)) >> 2)));
  x = (((x & 0x0f0f0f0f)) + ((((x & 0xf0f0f0f0)) >> 4)));
  x = (((x & 0x00ff00ff)) + ((((x & 0xff00ff00)) >> 8)));
  x = (((x & 0x0000ffff)) + ((((x & 0xffff0000)) >> 16)));
  return x;
}

func count_bits(x: dynamic)
{
  x = (((x & 0x5555555555555555)) + ((((x & 0xaaaaaaaaaaaaaaaa)) >> 1)));
  x = (((x & 0x3333333333333333)) + ((((x & 0xcccccccccccccccc)) >> 2)));
  x = (((x & 0x0f0f0f0f0f0f0f0f)) + ((((x & 0xf0f0f0f0f0f0f0f0)) >> 4)));
  x = (((x & 0x00ff00ff00ff00ff)) + ((((x & 0xff00ff00ff00ff00)) >> 8)));
  x = (((x & 0x0000ffff0000ffff)) + ((((x & 0xffff0000ffff0000)) >> 16)));
  x = (((x & 0x00000000ffffffff)) + ((((x & 0xffffffff00000000)) >> 32)));
  return x;
}

func reverse_bits(x: dynamic)
{
  x = (((((x >> 1)) & 0x55555555)) | ((((x << 1)) & 0xaaaaaaaa)));
  x = (((((x >> 2)) & 0x33333333)) | ((((x << 2)) & 0xcccccccc)));
  x = (((((x >> 4)) & 0x0f0f0f0f)) | ((((x << 4)) & 0xf0f0f0f0)));
  x = (((((x >> 8)) & 0x00ff00ff)) | ((((x << 8)) & 0xff00ff00)));
  x = (((((x >> 16)) & 0x0000ffff)) | ((((x << 16)) & 0xffff0000)));
  return x;
}

func reverse_bits(x: dynamic)
{
  x = (((((x >> 1)) & 0x5555555555555555)) | ((((x << 1)) & 0xaaaaaaaaaaaaaaaa)));
  x = (((((x >> 2)) & 0x3333333333333333)) | ((((x << 2)) & 0xcccccccccccccccc)));
  x = (((((x >> 4)) & 0x0f0f0f0f0f0f0f0f)) | ((((x << 4)) & 0xf0f0f0f0f0f0f0f0)));
  x = (((((x >> 8)) & 0x00ff00ff00ff00ff)) | ((((x << 8)) & 0xff00ff00ff00ff00)));
  x = (((((x >> 16)) & 0x0000ffff0000ffff)) | ((((x << 16)) & 0xffff0000ffff0000)));
  x = (((((x >> 32)) & 0x00000000ffffffff)) | ((((x << 32)) & 0xffffffff00000000)));
  return x;
}

func INC(a: dynamic, b: dynamic)
{
  a += b;
  if ((a >= MOD))
  {
    a -= MOD;
  }
}

func sum(a: dynamic, b: dynamic)
{
  a += b;
  if ((a >= MOD))
  {
    a -= MOD;
  }
  return a;
}

func DEC(a: dynamic, b: dynamic)
{
  a -= b;
  if ((a < 0))
  {
    a += MOD;
  }
}

func dff(a: dynamic, b: dynamic)
{
  a -= b;
  if ((a < 0))
  {
    a += MOD;
  }
  return a;
}

func MUL(a: dynamic, b: dynamic)
{
  a = ((cpp_cast(a) * b) % MOD);
}

func pdt(a: dynamic, b: dynamic)
{
  return ((cpp_cast(a) * b) % MOD);
}

func sum(a: dynamic, b: dynamic, c: dynamic)
{
  return sum(sum(a, b), c);
}

func sum(a: dynamic, b: dynamic, c: dynamic, d: dynamic)
{
  return sum(sum(a, b), sum(c, d));
}

func pdt(a: dynamic, b: dynamic, c: dynamic)
{
  return pdt(pdt(a, b), c);
}

func pdt(a: dynamic, b: dynamic, c: dynamic, d: dynamic)
{
  return pdt(pdt(pdt(a, b), c), d);
}

func pow(a: dynamic, b: dynamic)
{
  var c = cpp_construct(1);
  while (b)
  {
    if ((b & 1))
    {
      MUL(c, a);
    }
    MUL(a, a);
    b >>= 1;
  }
  return c;
}

func pow(a: dynamic, b: dynamic)
{
  var c = cpp_construct(1);
  while (b)
  {
    if ((b & 1))
    {
      c *= a;
    }
    a *= a;
    b >>= 1;
  }
  return c;
}

func I(b: dynamic)
{
  var a = MOD;
  var x1 = 0;
  var x2 = 1;
  var q: dynamic;
  while (true)
  {
    q = (a / b);
    a %= b;
    if ((!a))
    {
      return (((x2 + MOD)) % MOD);
    }
    DEC(x1, pdt(q, x2));
    q = (b / a);
    b %= a;
    if ((!b))
    {
      return (((x1 + MOD)) % MOD);
    }
    DEC(x2, pdt(q, x1));
  }
}

func DIA(a: dynamic, b: dynamic)
{
  MUL(a, I(b));
}

func qtt(a: dynamic, b: dynamic)
{
  return pdt(a, I(b));
}

func phi(n: dynamic)
{
  var res = n;
  {
    var i = 2;
    while ((sqr(i) <= n))
    {
      if ((!((n % i))))
      {
        DEC(res, qtt(res, i));
        while (true)
        {
          n /= i;
          if (!(((!((n % i))))))
          {
            break;
          }
        }
      }
      i += 1;
    }
  }
  if ((n != 1))
  {
    DEC(res, qtt(res, n));
  }
  return res;
}

