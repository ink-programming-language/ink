// COMPARE_BRANCH(Kind, Encoding, Spelling, Form, Width, Operator, Signed).
// Intentionally has no include guard: callers define COMPARE_BRANCH before inclusion.
// Explicit comparisons read two values and select a block target without storing condition state.

COMPARE_BRANCH(Je8mmb, 0x0042, "je8mmb", Mmb, 8, ==, false)
COMPARE_BRANCH(Je8mib, 0x0043, "je8mib", Mib, 8, ==, false)
