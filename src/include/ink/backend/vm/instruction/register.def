// REGISTER(Kind, Encoding, Spelling).
// Intentionally has no include guard: callers define REGISTER before inclusion.
// Register IDs occupy 8 bits and are independent of named VM symbols.
REGISTER(BP, 0x00, "bp")
REGISTER(SP, 0x01, "sp")
REGISTER(PC, 0x02, "pc")
// ZERO always reads as zero and is never a writable destination.
REGISTER(ZERO, 0x03, "zero")
// General-purpose registers store arbitrary 64-bit values and may also be memory address bases.
REGISTER(R0, 0x04, "r0")
REGISTER(R1, 0x05, "r1")
REGISTER(R2, 0x06, "r2")
REGISTER(R3, 0x07, "r3")
REGISTER(R4, 0x08, "r4")
REGISTER(R5, 0x09, "r5")
REGISTER(R6, 0x0A, "r6")
REGISTER(R7, 0x0B, "r7")
REGISTER(R8, 0x0C, "r8")
REGISTER(R9, 0x0D, "r9")
