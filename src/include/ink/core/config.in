#ifndef INK_CORE_CONFIG_H
#define INK_CORE_CONFIG_H

// Generated by CMake from config.in. Set INK_BUILD_MODE at configure time; do not edit this file.
// The Ink mode is independent of CMAKE_BUILD_TYPE and multi-config generator configurations.
#define INK_BUILD_MODE_NAME "@INK_BUILD_MODE_NAME@"
#cmakedefine01 INK_BUILD_DEBUG
#cmakedefine01 INK_BUILD_DEVELOPMENT
#cmakedefine01 INK_BUILD_SHIPPING

// Text IR format version in major.minor.patch form; independent of the binary wire version.
#define INK_IR_VERSION "0.0.1"

// Platform and pointer size describe the compiled target, not the machine running CMake.
#define INK_PLATFORM_NAME "@CMAKE_SYSTEM_NAME@"
#define INK_PLATFORM_POINTER_SIZE @CMAKE_SIZEOF_VOID_P@
#cmakedefine01 INK_PLATFORM_WINDOWS
#cmakedefine01 INK_PLATFORM_LINUX
#cmakedefine01 INK_PLATFORM_MACOS
#cmakedefine01 INK_PLATFORM_ANDROID
#cmakedefine01 INK_PLATFORM_IOS

#define INK_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@"
#define INK_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@"
#cmakedefine01 INK_COMPILER_MSVC
#cmakedefine01 INK_COMPILER_GCC
#cmakedefine01 INK_COMPILER_CLANG
// AppleClang is also Clang; clang-cl is Clang with the MSVC ABI, not the MSVC compiler.
#cmakedefine01 INK_COMPILER_APPLE_CLANG
#cmakedefine01 INK_COMPILER_MSVC_ABI

#endif
