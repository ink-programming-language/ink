#ifndef INK_DIAGNOSTIC
#error "Define INK_DIAGNOSTIC before including diagnostic.def"
#endif

INK_DIAGNOSTIC(Unknown, 0x00000000U, Unknown, "INK-0000", Unknown, "unknown diagnostic")
INK_DIAGNOSTIC(InvalidUtf8, 0x01000001U, Tokenizer, "INK-T0001", Error, "invalid UTF-8")
INK_DIAGNOSTIC(UnexpectedBom, 0x01000002U, Tokenizer, "INK-T0002", Error, "UTF-8 BOM is only allowed at the start of a file")
INK_DIAGNOSTIC(LoneCarriageReturn, 0x01000003U, Tokenizer, "INK-T0003", Error, "carriage return must be followed by line feed")
INK_DIAGNOSTIC(NonAsciiWhitespace, 0x01000004U, Tokenizer, "INK-T0004", Error, "only ASCII space and tab are source whitespace")
INK_DIAGNOSTIC(ForbiddenControlCharacter, 0x01000005U, Tokenizer, "INK-T0005", Error, "forbidden raw control character")
INK_DIAGNOSTIC(InvalidCharacter, 0x01000006U, Tokenizer, "INK-T0006", Error, "character cannot start an Ink token")
INK_DIAGNOSTIC(IdentifierNotNfc, 0x01000007U, Tokenizer, "INK-T0007", Error, "identifier is not in Unicode NFC")
INK_DIAGNOSTIC(InvisibleCharacter, 0x01000008U, Tokenizer, "INK-T0008", Error, "invisible format character must be written explicitly")
INK_DIAGNOSTIC(MissingBaseDigits, 0x01000009U, Tokenizer, "INK-T0009", Error, "base prefix must be followed by a digit")
INK_DIAGNOSTIC(DigitOutOfRange, 0x0100000AU, Tokenizer, "INK-T0010", Error, "digit does not belong to the literal base")
INK_DIAGNOSTIC(MisplacedNumericSeparator, 0x0100000BU, Tokenizer, "INK-T0011", Error, "numeric separator must be between two digits")
INK_DIAGNOSTIC(MissingExponentDigits, 0x0100000CU, Tokenizer, "INK-T0012", Error, "exponent must contain a decimal digit")
INK_DIAGNOSTIC(UnknownNumericSuffix, 0x0100000DU, Tokenizer, "INK-T0013", Error, "unknown numeric literal suffix")
INK_DIAGNOSTIC(InvalidNumericSuffix, 0x0100000EU, Tokenizer, "INK-T0014", Error, "numeric suffix is not valid for this literal")
INK_DIAGNOSTIC(UnsupportedNonDecimalFloat, 0x0100000FU, Tokenizer, "INK-T0015", Error, "non-decimal floating-point literals are not supported")
INK_DIAGNOSTIC(EmptyScalarLiteral, 0x01000010U, Tokenizer, "INK-T0016", Error, "scalar literal is empty")
INK_DIAGNOSTIC(MultipleScalarValues, 0x01000011U, Tokenizer, "INK-T0017", Error, "scalar literal must contain exactly one Unicode scalar value")
INK_DIAGNOSTIC(UnterminatedScalarLiteral, 0x01000012U, Tokenizer, "INK-T0018", Error, "scalar literal is not terminated on this source line")
INK_DIAGNOSTIC(UnknownEscape, 0x01000013U, Tokenizer, "INK-T0019", Error, "unknown escape sequence")
INK_DIAGNOSTIC(InvalidHexEscape, 0x01000014U, Tokenizer, "INK-T0020", Error, "hex escape requires exactly two hexadecimal digits")
INK_DIAGNOSTIC(InvalidUnicodeEscape, 0x01000015U, Tokenizer, "INK-T0021", Error, "Unicode escape requires one to six hexadecimal digits in braces")
INK_DIAGNOSTIC(InvalidUnicodeScalar, 0x01000016U, Tokenizer, "INK-T0022", Error, "escape does not designate a Unicode scalar value")
INK_DIAGNOSTIC(UnterminatedStringLiteral, 0x01000017U, Tokenizer, "INK-T0023", Error, "single-line string is not terminated on this source line")
INK_DIAGNOSTIC(MultilineOpeningLineBreakRequired, 0x01000018U, Tokenizer, "INK-T0024", Error, "multiline string opening delimiter must be followed by a line break")
INK_DIAGNOSTIC(UnterminatedMultilineStringLiteral, 0x01000019U, Tokenizer, "INK-T0025", Error, "multiline string has no closing delimiter")
INK_DIAGNOSTIC(InvalidMultilineIndentation, 0x0100001AU, Tokenizer, "INK-T0026", Error, "multiline string line does not match the closing indentation")
INK_DIAGNOSTIC(UnterminatedBlockComment, 0x0100001BU, Tokenizer, "INK-T0027", Error, "block comment is not terminated")
INK_DIAGNOSTIC(BlockCommentNestingLimit, 0x0100001CU, Tokenizer, "INK-T0028", Error, "block comment nesting limit exceeded")
