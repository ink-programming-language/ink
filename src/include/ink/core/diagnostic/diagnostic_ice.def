#ifndef INK_DIAGNOSTIC
#error "Define INK_DIAGNOSTIC before including diagnostic_ice.def"
#endif

INK_DIAGNOSTIC(ConfigNotFound, 0x08000001U, Core, "INK-C0001", InternalCompilerError, Error, "configuration key is not registered", "configuration key {ActualValue} is not registered", INK_DIAGNOSTIC_ARGUMENTS(INK_DIAGNOSTIC_ARGUMENT(ActualValue, UnsignedInteger)))
INK_DIAGNOSTIC(ConfigInvalidSizeDefault, 0x08000002U, Core, "INK-C0002", InternalCompilerError, Error, "configuration size default is invalid", "configuration '{SymbolName}' has invalid size default '{Actual}'", INK_DIAGNOSTIC_ARGUMENTS(INK_DIAGNOSTIC_ARGUMENT(SymbolName, String), INK_DIAGNOSTIC_ARGUMENT(Actual, String)))

// All failures other than incorrect user source code, including resource limits.
INK_DIAGNOSTIC(NormalizationFailed, 0x01000014U, Tokenizer, "INK-T0020", InternalCompilerError, Error, "could not normalize the identifier to NFC", "could not normalize the identifier to NFC", INK_DIAGNOSTIC_ARGUMENTS())
INK_DIAGNOSTIC(TokenizerSourceNotFound, 0x01000015U, Tokenizer, "INK-T0021", InternalCompilerError, Error, "source buffer is not registered with this context", "source buffer is not registered with this context", INK_DIAGNOSTIC_ARGUMENTS())
INK_DIAGNOSTIC(SourceTooLarge, 0x01000016U, Tokenizer, "INK-T0022", InternalCompilerError, Error, "source exceeds the representable byte-offset limit", "source exceeds the representable byte-offset limit", INK_DIAGNOSTIC_ARGUMENTS())
INK_DIAGNOSTIC(TokenizerInvalidNumericToken, 0x01000017U, Tokenizer, "INK-T0023", InternalCompilerError, Error, "tokenizer produced an invalid numeric token", "invalid numeric token produced by tokenizer: {Description}", INK_DIAGNOSTIC_ARGUMENTS(INK_DIAGNOSTIC_ARGUMENT(Description, String)))
INK_DIAGNOSTIC(ParserLimitExceeded, 0x02000004U, Parser, "INK-P0004", InternalCompilerError, Error, "parser resource limit exceeded", "parser resource limit exceeded", INK_DIAGNOSTIC_ARGUMENTS())
INK_DIAGNOSTIC(ParserInvalidTokenReference, 0x02000030U, Parser, "INK-P0048", InternalCompilerError, Error, "invalid token reference", "token index {ActualValue} is out of bounds for input of {Size} tokens", INK_DIAGNOSTIC_ARGUMENTS(INK_DIAGNOSTIC_ARGUMENT(ActualValue, UnsignedInteger), INK_DIAGNOSTIC_ARGUMENT(Size, UnsignedInteger)))
