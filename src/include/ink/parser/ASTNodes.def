// AST_NODE(Name, Base, Category, Id). IDs are stable and independent of declaration order.
// Assign new IDs to new nodes; do not renumber existing nodes or reuse removed IDs.
AST_NODE(ModuleAST, ASTNodeBase, Root, 0)
AST_NODE(TypeSyntax, ASTNodeBase, Root, 1)
AST_NODE(MissingExpr, Expr, Expr, 2)
AST_NODE(ErrorExpr, Expr, Expr, 3)
AST_NODE(MissingStmt, Stmt, Stmt, 4)
AST_NODE(ErrorStmt, Stmt, Stmt, 5)
AST_NODE(MissingDecl, Decl, Decl, 6)
AST_NODE(ErrorDecl, Decl, Decl, 7)
AST_NODE(MissingBindingPattern, BindingPattern, BindingPattern, 8)
AST_NODE(ErrorBindingPattern, BindingPattern, BindingPattern, 9)
AST_NODE(MissingMatchPattern, MatchPattern, MatchPattern, 10)
AST_NODE(ErrorMatchPattern, MatchPattern, MatchPattern, 11)
AST_NODE(NameExpr, Expr, Expr, 12)
AST_NODE(LiteralExpr, Expr, Expr, 13)
AST_NODE(UnaryExpr, Expr, Expr, 14)
