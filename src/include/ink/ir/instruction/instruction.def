// INSTRUCTION(Kind, Number, Class, Spelling).
// Intentionally has no include guard: callers define INSTRUCTION before inclusion.
// Numbers explicitly define InstructionKind values.
// Each Class must provide detail::InstructionOperands<Class> in instruction.cpp; this list also generates operand dispatch.
INSTRUCTION(Add, 0, AddInstruction, "add")
INSTRUCTION(Return, 1, ReturnInstruction, "return")
INSTRUCTION(Alloca, 2, AllocaInstruction, "alloca")
INSTRUCTION(Load, 3, LoadInstruction, "load")
INSTRUCTION(Store, 4, StoreInstruction, "store")
INSTRUCTION(Branch, 5, BranchInstruction, "branch")
INSTRUCTION(CondBranch, 6, CondBranchInstruction, "cond_branch")
INSTRUCTION(Phi, 7, PhiInstruction, "phi")
