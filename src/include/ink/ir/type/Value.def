#ifndef INK_VALUE
#error "Define INK_VALUE before including Value.def"
#endif

// INK_VALUE(Kind, Name, FixedSize)
// Intentionally included more than once. Sizes are in bytes, not host C++ object sizes.
// std::nullopt means the size depends on the bit width, aggregate layout or target, requires template instantiation, or does not apply to this kind;
// it is distinct from a valid zero-byte value such as void or an empty array.
INK_VALUE(Bool, "bool", 1)
INK_VALUE(Integer, "integer", std::nullopt)
INK_VALUE(Float, "float", std::nullopt)
INK_VALUE(Array, "array", std::nullopt)
INK_VALUE(Class, "class", std::nullopt)
INK_VALUE(Interface, "interface", std::nullopt)
INK_VALUE(Struct, "struct", std::nullopt)
INK_VALUE(Pointer, "pointer", std::nullopt)
INK_VALUE(Reference, "reference", std::nullopt)
INK_VALUE(FunctionType, "function_type", std::nullopt)
INK_VALUE(Function, "function", std::nullopt)
INK_VALUE(Parameter, "parameter", std::nullopt)
INK_VALUE(GenericClass, "generic_class", std::nullopt)
INK_VALUE(GenericFunction, "generic_function", std::nullopt)
INK_VALUE(GenericVar, "generic_var", std::nullopt)
INK_VALUE(BasicBlock, "basic_block", std::nullopt)
INK_VALUE(Instruction, "instruction", std::nullopt)
INK_VALUE(BoolConstant, "bool_constant", 1)
INK_VALUE(IntegerConstant, "integer_constant", std::nullopt)
INK_VALUE(FloatConstant, "float_constant", std::nullopt)
INK_VALUE(ArrayConstant, "array_constant", std::nullopt)
INK_VALUE(NullPointerConstant, "null_pointer_constant", std::nullopt)
INK_VALUE(StringConstant, "string_constant", std::nullopt)
INK_VALUE(Void, "void", 0)
INK_VALUE(Variadic, "variadic", std::nullopt)
INK_VALUE(GlobalVariable, "global_variable", std::nullopt)
INK_VALUE(NullPointer, "null_pointer", std::nullopt)
INK_VALUE(GetElementPtrInstruction, "getelementptr", std::nullopt)
INK_VALUE(CallInstruction, "call", std::nullopt)
INK_VALUE(ICmpInstruction, "icmp", std::nullopt)
INK_VALUE(BranchInstruction, "br", std::nullopt)
INK_VALUE(ReturnInstruction, "ret", std::nullopt)
INK_VALUE(ConditionalBranchInstruction, "cond_br", std::nullopt)
INK_VALUE(Module, "module", std::nullopt)
INK_VALUE(NegInstruction, "neg", std::nullopt)
INK_VALUE(MetaType, "type", std::nullopt)
INK_VALUE(AllocaInstruction, "alloca", std::nullopt)
INK_VALUE(LoadInstruction, "load", std::nullopt)
INK_VALUE(StoreInstruction, "store", std::nullopt)
