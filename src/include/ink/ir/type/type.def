// TYPE(Kind, Class, Spelling).
// Intentionally has no include guard: callers define TYPE before inclusion.
TYPE(Meta, MetaType, "type")
TYPE(Integer, IntegerType, "integer")
TYPE(Float, FloatType, "float")
TYPE(Bool, BoolType, "bool")
TYPE(Void, VoidType, "void")
TYPE(Array, ArrayType, "array")
TYPE(Struct, StructType, "struct")
TYPE(Object, ObjectType, "object")
TYPE(Reference, ReferenceType, "reference")
TYPE(Function, FunctionType, "function")
