// docs/Ink-Lexical-Rules.md. Intentionally included more than once.
// C++ names follow the repository convention; DisplayName is the grammar name.

#ifdef INK_TOKEN
INK_TOKEN(EndOfFile, "END_OF_FILE")
INK_TOKEN(Identifier, "IDENTIFIER")
INK_TOKEN(IntegerLiteral, "INTEGER_LITERAL")
INK_TOKEN(FloatLiteral, "FLOAT_LITERAL")
INK_TOKEN(CharLiteral, "CHAR_LITERAL")
INK_TOKEN(StringLiteral, "STRING_LITERAL")
#endif

#ifdef INK_KEYWORD
INK_KEYWORD(KwAs, "KW_AS", "as")
INK_KEYWORD(KwBreak, "KW_BREAK", "break")
INK_KEYWORD(KwCase, "KW_CASE", "case")
INK_KEYWORD(KwClass, "KW_CLASS", "class")
INK_KEYWORD(KwComptime, "KW_COMPTIME", "comptime")
INK_KEYWORD(KwConst, "KW_CONST", "const")
INK_KEYWORD(KwContinue, "KW_CONTINUE", "continue")
INK_KEYWORD(KwDefault, "KW_DEFAULT", "default")
INK_KEYWORD(KwDefer, "KW_DEFER", "defer")
INK_KEYWORD(KwDo, "KW_DO", "do")
INK_KEYWORD(KwElse, "KW_ELSE", "else")
INK_KEYWORD(KwEnum, "KW_ENUM", "enum")
INK_KEYWORD(KwField, "KW_FIELD", "field")
INK_KEYWORD(KwFor, "KW_FOR", "for")
INK_KEYWORD(KwFrom, "KW_FROM", "from")
INK_KEYWORD(KwFunc, "KW_FUNC", "func")
INK_KEYWORD(KwIf, "KW_IF", "if")
INK_KEYWORD(KwImplements, "KW_IMPLEMENTS", "implements")
INK_KEYWORD(KwImport, "KW_IMPORT", "import")
INK_KEYWORD(KwIn, "KW_IN", "in")
INK_KEYWORD(KwInterface, "KW_INTERFACE", "interface")
INK_KEYWORD(KwMatch, "KW_MATCH", "match")
INK_KEYWORD(KwReturn, "KW_RETURN", "return")
INK_KEYWORD(KwSwitch, "KW_SWITCH", "switch")
INK_KEYWORD(KwVar, "KW_VAR", "var")
INK_KEYWORD(KwWhile, "KW_WHILE", "while")
INK_KEYWORD(KwYield, "KW_YIELD", "yield")
#endif

#ifdef INK_SYMBOL
INK_SYMBOL(LParen, "LPAREN", "(")
INK_SYMBOL(RParen, "RPAREN", ")")
INK_SYMBOL(LBracket, "LBRACKET", "[")
INK_SYMBOL(RBracket, "RBRACKET", "]")
INK_SYMBOL(LBrace, "LBRACE", "{")
INK_SYMBOL(RBrace, "RBRACE", "}")
INK_SYMBOL(Comma, "COMMA", ",")
INK_SYMBOL(Semicolon, "SEMICOLON", ";")
INK_SYMBOL(Colon, "COLON", ":")
INK_SYMBOL(DoubleColon, "DOUBLE_COLON", "::")
INK_SYMBOL(Dot, "DOT", ".")
INK_SYMBOL(Ellipsis, "ELLIPSIS", "...")
INK_SYMBOL(Underscore, "UNDERSCORE", "_")
INK_SYMBOL(Plus, "PLUS", "+")
INK_SYMBOL(Minus, "MINUS", "-")
INK_SYMBOL(Star, "STAR", "*")
INK_SYMBOL(Slash, "SLASH", "/")
INK_SYMBOL(Percent, "PERCENT", "%")
INK_SYMBOL(PlusPlus, "PLUS_PLUS", "++")
INK_SYMBOL(MinusMinus, "MINUS_MINUS", "--")
INK_SYMBOL(Bang, "BANG", "!")
INK_SYMBOL(Tilde, "TILDE", "~")
INK_SYMBOL(Amp, "AMP", "&")
INK_SYMBOL(Pipe, "PIPE", "|")
INK_SYMBOL(Caret, "CARET", "^")
INK_SYMBOL(AmpAmp, "AMP_AMP", "&&")
INK_SYMBOL(PipePipe, "PIPE_PIPE", "||")
INK_SYMBOL(ShiftLeft, "SHIFT_LEFT", "<<")
INK_SYMBOL(ShiftRight, "SHIFT_RIGHT", ">>")
INK_SYMBOL(Less, "LESS", "<")
INK_SYMBOL(LessEqual, "LESS_EQUAL", "<=")
INK_SYMBOL(Greater, "GREATER", ">")
INK_SYMBOL(GreaterEqual, "GREATER_EQUAL", ">=")
INK_SYMBOL(EqualEqual, "EQUAL_EQUAL", "==")
INK_SYMBOL(BangEqual, "BANG_EQUAL", "!=")
INK_SYMBOL(Assign, "ASSIGN", "=")
INK_SYMBOL(PlusAssign, "PLUS_ASSIGN", "+=")
INK_SYMBOL(MinusAssign, "MINUS_ASSIGN", "-=")
INK_SYMBOL(StarAssign, "STAR_ASSIGN", "*=")
INK_SYMBOL(SlashAssign, "SLASH_ASSIGN", "/=")
INK_SYMBOL(PercentAssign, "PERCENT_ASSIGN", "%=")
INK_SYMBOL(AmpAssign, "AMP_ASSIGN", "&=")
INK_SYMBOL(PipeAssign, "PIPE_ASSIGN", "|=")
INK_SYMBOL(CaretAssign, "CARET_ASSIGN", "^=")
INK_SYMBOL(ShiftLeftAssign, "SHIFT_LEFT_ASSIGN", "<<=")
INK_SYMBOL(ShiftRightAssign, "SHIFT_RIGHT_ASSIGN", ">>=")
INK_SYMBOL(Question, "QUESTION", "?")
INK_SYMBOL(NullCoalesce, "NULL_COALESCE", "??")
INK_SYMBOL(QuestionDot, "QUESTION_DOT", "?.")
INK_SYMBOL(Arrow, "ARROW", "->")
INK_SYMBOL(FatArrow, "FAT_ARROW", "=>")
#endif
