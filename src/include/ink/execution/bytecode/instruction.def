// Included repeatedly to generate BytecodeOpcode and its operand metadata. Kinds map
// directly to BytecodeInstruction::Operands[0..3]; unused operands (None) are zero.
// ReadSlot/WriteSlot are activation-relative 32-bit slot indexes, Target is an
// absolute instruction index within this function.
// Layout refers to the shared lowered layout table; Local names a frame cell.
// DataOffset/DataLength select owned constant bytes; CallSite indexes Calls.
// Predicate and Status contain their corresponding enum value, not an address.
// No IR-node, host-data or host-code pointers are embedded in an instruction.
#ifndef INK_INSTRUCTION
#error "Define INK_INSTRUCTION before including instruction.def"
#endif

// INK_INSTRUCTION(Name, Operand0Kind, Operand1Kind, Operand2Kind, Operand3Kind)
// Local storage never exposes its address. Each AllocaLocal resets the assigned
// frame cell and consumes an allocation budget entry, including inside loops.
INK_INSTRUCTION(Alloca, WriteSlot, Layout, None, None)
INK_INSTRUCTION(AllocaLocal, WriteSlot, Layout, Local, None)
INK_INSTRUCTION(Load, WriteSlot, ReadSlot, None, None)
INK_INSTRUCTION(LoadI8, WriteSlot, ReadSlot, None, None)
INK_INSTRUCTION(LoadI16, WriteSlot, ReadSlot, None, None)
INK_INSTRUCTION(LoadI32, WriteSlot, ReadSlot, None, None)
INK_INSTRUCTION(LoadI64, WriteSlot, ReadSlot, None, None)
INK_INSTRUCTION(LoadLocal, WriteSlot, ReadSlot, None, None)
INK_INSTRUCTION(Store, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(StoreI8, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(StoreI16, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(StoreI32, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(StoreI64, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(StoreLocal, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(CString, WriteSlot, DataOffset, DataLength, None)
INK_INSTRUCTION(AddI8, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(AddI16, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(AddI32, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(AddI64, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(AddWide, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(LogicalNot, WriteSlot, ReadSlot, None, None)
INK_INSTRUCTION(LogicalAnd, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(LogicalOr, WriteSlot, ReadSlot, ReadSlot, None)
INK_INSTRUCTION(CompareSigned8, WriteSlot, ReadSlot, ReadSlot, Predicate)
INK_INSTRUCTION(CompareSigned16, WriteSlot, ReadSlot, ReadSlot, Predicate)
INK_INSTRUCTION(CompareSigned32, WriteSlot, ReadSlot, ReadSlot, Predicate)
INK_INSTRUCTION(CompareSigned64, WriteSlot, ReadSlot, ReadSlot, Predicate)
INK_INSTRUCTION(CompareUnsigned8, WriteSlot, ReadSlot, ReadSlot, Predicate)
INK_INSTRUCTION(CompareUnsigned16, WriteSlot, ReadSlot, ReadSlot, Predicate)
INK_INSTRUCTION(CompareUnsigned32, WriteSlot, ReadSlot, ReadSlot, Predicate)
INK_INSTRUCTION(CompareUnsigned64, WriteSlot, ReadSlot, ReadSlot, Predicate)
INK_INSTRUCTION(CompareWide, WriteSlot, ReadSlot, ReadSlot, Predicate)
INK_INSTRUCTION(CompareBool, WriteSlot, ReadSlot, ReadSlot, Predicate)
INK_INSTRUCTION(CallDirect, WriteSlot, CallSite, None, None)
INK_INSTRUCTION(CallIndirect, WriteSlot, CallSite, None, None)
INK_INSTRUCTION(Jump, None, Target, None, None)
INK_INSTRUCTION(JumpIf, None, ReadSlot, Target, Target)
INK_INSTRUCTION(Return, None, ReadSlot, None, None)
INK_INSTRUCTION(ReturnVoid, None, None, None, None)
INK_INSTRUCTION(Function, WriteSlot, None, None, None)
INK_INSTRUCTION(Failure, None, Status, None, None)
