INK_SEMANTIC_TYPE(Meta, BuiltinType)
INK_SEMANTIC_TYPE(Void, BuiltinType)
INK_SEMANTIC_TYPE(Bool, BuiltinType)
INK_SEMANTIC_TYPE(Integer, BuiltinType)
INK_SEMANTIC_TYPE(Float, BuiltinType)
INK_SEMANTIC_TYPE(Array, BuiltinType)
INK_SEMANTIC_TYPE(Slice, BuiltinType)
INK_SEMANTIC_TYPE(Pointer, BuiltinType)
INK_SEMANTIC_TYPE(Reference, BuiltinType)
INK_SEMANTIC_TYPE(Class, UserDefinedType)
INK_SEMANTIC_TYPE(Enum, UserDefinedType)
INK_SEMANTIC_TYPE(Interface, UserDefinedType)
INK_SEMANTIC_TYPE(Function, BuiltinType)
