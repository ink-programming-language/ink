# Check the real target graph during configuration, including dependencies hidden behind helper targets.
function(ink_check_frontend_target_dependencies)
  set(PendingTargets ink_frontend ink_core)
  set(PendingPaths ink_frontend ink_core)
  set(VisitedTargets)

  while(PendingTargets)
    list(POP_FRONT PendingTargets Target)
    list(POP_FRONT PendingPaths DependencyPath)
    get_target_property(AliasedTarget "${Target}" ALIASED_TARGET)
    if(AliasedTarget)
      set(Target "${AliasedTarget}")
    endif()

    if(Target STREQUAL "ink_ir" OR Target STREQUAL "ink_semantic")
      message(FATAL_ERROR "Frontend dependency boundary violated: ${DependencyPath}")
    endif()
    if(Target IN_LIST VisitedTargets)
      continue()
    endif()
    list(APPEND VisitedTargets "${Target}")

    foreach(Property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES MANUALLY_ADDED_DEPENDENCIES)
      get_target_property(Dependencies "${Target}" "${Property}")
      if(NOT Dependencies)
        continue()
      endif()

      # Inspect all generator-expression branches so the boundary applies to every build configuration.
      string(REGEX REPLACE "\\$<[A-Za-z_][A-Za-z0-9_]*:" ";" Dependencies "${Dependencies}")
      string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_:+.-]*" DependencyNames "${Dependencies}")
      foreach(Dependency IN LISTS DependencyNames)
        if(TARGET "${Dependency}")
          list(APPEND PendingTargets "${Dependency}")
          list(APPEND PendingPaths "${DependencyPath} -> ${Dependency}")
        endif()
      endforeach()
    endforeach()
  endwhile()
endfunction()

function(ink_check_frontend_source_dependencies SourceDirectory)
  set(Violations)
  foreach(Module frontend core)
    set(ModuleFiles)
    foreach(ModuleDirectory "${SourceDirectory}/src/include/ink/${Module}" "${SourceDirectory}/src/lib/${Module}")
      if(NOT IS_DIRECTORY "${ModuleDirectory}")
        message(FATAL_ERROR "Missing module directory: ${ModuleDirectory}")
      endif()
      file(GLOB_RECURSE DirectoryFiles LIST_DIRECTORIES false "${ModuleDirectory}/*.h" "${ModuleDirectory}/*.hpp" "${ModuleDirectory}/*.hxx" "${ModuleDirectory}/*.c" "${ModuleDirectory}/*.cpp" "${ModuleDirectory}/*.cxx" "${ModuleDirectory}/*.inc" "${ModuleDirectory}/*.def")
      list(APPEND ModuleFiles ${DirectoryFiles})
    endforeach()

    foreach(SourceFile IN LISTS ModuleFiles)
      file(READ "${SourceFile}" Source)
      # This is a source-boundary lint, not a C++ parser; inactive preprocessor branches are checked too.
      string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" " " Source "${Source}")
      string(REGEX REPLACE "//[^\n]*" " " Source "${Source}")
      set(ForbiddenInclude "(^|\n)[ \t]*#[ \t]*include[ \t]*[\"<]ink/(ir|semantic)(/|[\">])")
      set(ForbiddenQualifiedName "(^|[^A-Za-z0-9_])(ir|semantic)[ \t\r\n]*::|(^|[^A-Za-z0-9_])ink[ \t\r\n]*::[ \t\r\n]*(ir|semantic)([^A-Za-z0-9_]|$)")
      set(ForbiddenNamespace "(namespace|using[ \t\r\n]+namespace)[ \t\r\n]+(ir|semantic)([^A-Za-z0-9_]|$)")
      if(Source MATCHES "${ForbiddenInclude}" OR Source MATCHES "${ForbiddenQualifiedName}" OR Source MATCHES "${ForbiddenNamespace}")
        file(RELATIVE_PATH RelativeSource "${SourceDirectory}" "${SourceFile}")
        list(APPEND Violations "${RelativeSource}")
      endif()
    endforeach()
  endforeach()

  if(Violations)
    list(JOIN Violations "\n  " ViolationList)
    message(FATAL_ERROR "Frontend/Core must not include or reference IR/semantic modules:\n  ${ViolationList}")
  endif()
  message(STATUS "Frontend/Core source dependency boundary passed")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT DEFINED INK_SOURCE_DIR)
    get_filename_component(INK_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
  endif()
  ink_check_frontend_source_dependencies("${INK_SOURCE_DIR}")
endif()
