include_guard(GLOBAL)

set(INK_BUILD_MODE "debug" CACHE STRING "Ink build mode: debug, development, or shipping")
set_property(CACHE INK_BUILD_MODE PROPERTY STRINGS debug development shipping)

# Generate into the binary tree so separate builds cannot overwrite each other's configuration.
function(ink_configure_build_config IncludeDirectory BuildMode)
  string(TOLOWER "${BuildMode}" INK_BUILD_MODE_NAME)
  if(NOT INK_BUILD_MODE_NAME MATCHES "^(debug|development|shipping)$")
    message(FATAL_ERROR "Invalid INK_BUILD_MODE '${BuildMode}'; expected debug, development, or shipping")
  endif()

  foreach(Mode IN ITEMS DEBUG DEVELOPMENT SHIPPING)
    set(INK_BUILD_${Mode} 0)
  endforeach()
  string(TOUPPER "${INK_BUILD_MODE_NAME}" UpperBuildMode)
  set(INK_BUILD_${UpperBuildMode} 1)

  # These describe the target platform, including when the compiler is cross-compiling.
  foreach(Platform IN ITEMS WINDOWS LINUX MACOS ANDROID IOS)
    set(INK_PLATFORM_${Platform} 0)
  endforeach()
  if(CMAKE_SYSTEM_NAME MATCHES "^Windows")
    set(INK_PLATFORM_WINDOWS 1)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(INK_PLATFORM_LINUX 1)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(INK_PLATFORM_MACOS 1)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Android")
    set(INK_PLATFORM_ANDROID 1)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    set(INK_PLATFORM_IOS 1)
  endif()

  foreach(Compiler IN ITEMS MSVC GCC CLANG APPLE_CLANG MSVC_ABI)
    set(INK_COMPILER_${Compiler} 0)
  endforeach()
  if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    set(INK_COMPILER_MSVC 1)
  elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set(INK_COMPILER_GCC 1)
  elseif(CMAKE_CXX_COMPILER_ID MATCHES "^(Clang|AppleClang)$")
    set(INK_COMPILER_CLANG 1)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
      set(INK_COMPILER_APPLE_CLANG 1)
    endif()
  endif()
  if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC")
    set(INK_COMPILER_MSVC_ABI 1)
  endif()

  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/include/ink/core/config.in" "${IncludeDirectory}/ink/core/config.h" @ONLY)
endfunction()
